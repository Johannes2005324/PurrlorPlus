# Copy to .env (repo root) and fill in before running:
#   docker compose -f deploy/docker-compose.yml --env-file .env up --build
# See docs/voice-architecture.md for how these pieces fit together, and docs/deployment.md for
# a full guided walkthrough (VPS, DNS, TLS, nginx) if you're starting from nothing.

# --- LiveKit ---
# Generate a random key/secret pair (e.g. `openssl rand -hex 16` for each). Shared by the
# livekit and token-server services — must match exactly, both read from these same two vars.
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Public IP (or hostname) of the machine running the livekit service — used for ICE candidates
# so clients (including ones behind NAT) can actually reach it. Not needed if you're fronting
# LiveKit with the optional TURN relay (see deploy/livekit.yaml's commented-out turn: block).
HOST_IP=

# Address the four services' reverse-proxied ports bind to on this host. Leave unset (defaults
# to 127.0.0.1) if nginx runs on this SAME host — the normal case. Only set this if nginx instead
# runs on a separate edge/proxy host reaching this one over a private network (e.g. a WireGuard
# tunnel, common with a Cloudflare-fronted edge) — set it to this host's address on that private
# network so the edge host can reach it. See docs/deployment.md's "Split edge-proxy + origin"
# section. Never 0.0.0.0 — these ports have no TLS/auth of their own; nginx provides both.
# BIND_ADDR=10.40.40.2

# Origins allowed to call the token server and push gateway, comma-separated. Supports one leading
# wildcard subdomain per entry (e.g. https://*.example.com). Use * only for local testing. Voice
# (/api/livekit/) answers any origin regardless, so a Space's members from other Matrix servers can
# join its voice channels from their own server's app (services/token-server/src/corsPolicy.ts).
# This is Purrlor's own web client's origin (see docs/deployment.md) — deliberately not "chat."
# or "matrix.", so it doesn't collide with wherever your *existing* homeserver already lives.
ALLOWED_ORIGINS=https://app.YOUR_DOMAIN

# --- Web client ---
# Locks the login and register screens to this one homeserver — they show its name instead of a
# homeserver field. Read when the web container starts (no rebuild needed to change it). Leave
# unset for a general-purpose client that asks which homeserver to use.
# PURRLOR_HOMESERVER_URL=https://matrix.YOUR_DOMAIN

# --- Outbound proxy (optional) ---
# For a host that can only reach the internet through an HTTP(S) proxy. Used by the services that
# make outbound requests (token-server, push-gateway, matrix) and by their image builds. Must be an
# address containers can reach — not 127.0.0.1. OUTBOUND_NO_PROXY must keep the in-stack names, or
# container-to-container traffic gets sent to the proxy. deploy/setup.sh also configures the
# Docker daemon (image pulls) and certbot renewal to use it; do those by hand if you skip the
# script. See docs/deployment.md's "Outbound proxy".
# OUTBOUND_PROXY=http://user:password@proxy.internal:3128
# OUTBOUND_NO_PROXY=localhost,127.0.0.1,::1,livekit,token-server,push-gateway,web,matrix,host.docker.internal
# The containers' own address for the proxy, when it's on this host's loopback (a NekoProxy agent on
# localhost:8080, say) — containers reach the host as host.docker.internal. Unset: OUTBOUND_PROXY.
# CONTAINER_PROXY=http://host.docker.internal:8080

# --- Bundled homeserver (optional) ---
# Set by deploy/setup.sh when it provisions the homeserver (the default — see docs/deployment.md
# "Option B"). Leave all of these unset if you're bringing your own homeserver: without
# COMPOSE_PROFILES=matrix the `matrix` service in deploy/docker-compose.yml never starts, and
# MATRIX_HOMESERVER_URL below just points at your existing one instead.
# COMPOSE_PROFILES=matrix
# MATRIX_SERVER_NAME=YOUR_DOMAIN
# Anyone with this token can sign up (the web client asks for it). Change it to revoke it.
# MATRIX_REGISTRATION_TOKEN=
# false closes sign-up entirely; the admin creates accounts from the admin room instead.
# MATRIX_ALLOW_REGISTRATION=true
# Where the homeserver takes a client's address from (Settings > Sessions, its rate limits):
# x_real_ip (the default), the header every proxy config here sets, or direct (the connecting
# address, which behind a proxy is the proxy). Only the bundled homeserver reads it.
# MATRIX_IP_SOURCE=x_real_ip
# Link previews (the card under a message or post with a link): every site by default, fetched by
# the homeserver (never a private address), and never asked for in encrypted conversations.
# [] turns them off.
# MATRIX_URL_PREVIEWS=["*"]

# --- Token server's Matrix service-bot account ---
# This bot must be a member of any room you want voice-gated — it stays joined and reads
# membership/power level locally (services/token-server/src/membership.ts). Register a
# dedicated account for it (not a real user's account) on your homeserver first.
# You don't have to invite it into rooms by hand: the token server publishes this user ID at
# GET /api/livekit/config, and the app invites it into the space and its voice channels itself
# from there (see docs/voice-architecture.md's "Service bot membership").
# The bot only ever joins rooms on its own homeserver that belong to a space it serves — it
# ignores every other invite, including any sent from a federated server. See
# VOICE_ALLOWED_SPACES below and services/token-server/src/tenancy.ts.
# This is your *existing* Matrix homeserver's URL — NOT one of Purrlor's own subdomains above.
# With the bundled homeserver, it's http://matrix:8008 (the compose network, not the public URL).
MATRIX_HOMESERVER_URL=https://matrix.YOUR_DOMAIN

# Preferred: a long-lived access token (avoids storing a password here at all).
MATRIX_BOT_USER_ID=@purrlor-voice-bot:YOUR_DOMAIN
MATRIX_BOT_ACCESS_TOKEN=

# Alternative to the pair above: username/password login on every restart. Leave both empty if
# using MATRIX_BOT_ACCESS_TOKEN instead.
# MATRIX_BOT_USERNAME=
# MATRIX_BOT_PASSWORD=

# Power level at/above which a room member gets LiveKit roomAdmin grants (mute-others, etc.).
# Optional — defaults to 50 (Matrix's own "moderator" convention) if unset.
VOICE_MODERATOR_POWER_LEVEL=50

# Which spaces this deployment mints voice tokens for, comma-separated room IDs
# (!abc123:YOUR_DOMAIN). Optional. Left unset, it serves every space on this homeserver that the
# bot above has been invited into — the right default for a private server, where the homeserver's
# own registration settings already decide who can create a space at all.
# Set it if registration is open, or if this LiveKit deployment is meant for specific spaces:
# the bot then ignores invites from every other space, and the token server refuses their
# channels. Either way it never serves a room created on another homeserver.
# VOICE_ALLOWED_SPACES=

# --- Bug reports (docs/bug-reports.md) ---
# Typing `!bug <project> <what's wrong>` in the app sends a bug report instead of a message, e.g.
# `!bug purrlor emojis don't work on mobile`. BUG_PROJECTS is what <project> may be (commas or
# spaces; default purrlor). The service bot posts each report in a private "Bug reports" room and
# invites the accounts in BUG_REPORT_ADMINS to it; `sudo purrlor bugs` lists them either way.
# BUG_PROJECTS=purrlor,ultimit
# BUG_REPORT_ADMINS=@you:YOUR_DOMAIN

# --- This deployment's voice server, for the web client ---
# Voice is configured per Space (docs/voice-architecture.md's "State events"), but these give every
# Space created on this homeserver this deployment's voice server automatically, the first time an
# admin opens it — so voice channels work with nothing to set in the app. Leave both unset to
# configure it per Space by hand under Space Settings instead.
PURRLOR_LIVEKIT_URL=wss://livekit.YOUR_DOMAIN
# The token server's POST endpoint — the app's own address, when nginx serves /api/livekit/.
PURRLOR_TOKEN_ENDPOINT=https://app.YOUR_DOMAIN/api/livekit/token

# --- Push gateway (background push notifications, services/push-gateway) ---
# Generate with `npx web-push generate-vapid-keys` (from services/push-gateway, or anywhere
# with the `web-push` package available) — a fresh pair, not shared with any other deployment.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# A mailto: address or this deployment's own https:// URL — required by the Web Push spec so a
# push service (e.g. Chrome's) has somewhere to reach out if this deployment misbehaves.
VAPID_SUBJECT=mailto:admin@YOUR_DOMAIN

# --- Errors and metrics (docs/deployment.md, "Errors and metrics") ---
# The bearer token for the token server's and push gateway's /metrics, /stats and /errors, which
# `purrlor errors`, `purrlor metrics` and a Prometheus scrape use. Unset: those routes don't exist.
# Generate with `openssl rand -hex 32` (deploy/setup.sh and `purrlor update` make one).
PURRLOR_METRICS_TOKEN=

# --- This deployment's push gateway, for the web client ---
# The default gateway for background notifications (anyone can still pick another under Account
# Settings). The app's own address, when nginx serves /api/push/. Unset: people enter it themselves.
PURRLOR_PUSH_GATEWAY_URL=https://app.YOUR_DOMAIN/api/push
