# Creates the room behind the app's global emote library (apps/web/src/matrix/emoteLibrary.ts,
# which explains the design; docs/api.md lists the room's settings). Made by the admin rather than
# by the app on first use, so the admin — not whoever happened to open the picker first — owns its
# moderation. Everyone can add a pack under their own user ID (level 0); moderators (50) can hide
# images, take down packs and mute people. Does nothing if the library already exists.
# Same runtime as ADMIN_JS, but plain client-server API, so it works on any homeserver.
read -r -d '' EMOTES_JS <<'JS' || true
const [base, user, password] = require('fs').readFileSync(0, 'utf8').split('\n');
let token;
async function call(method, path, body) {
  const res = await fetch(base.replace(/\/+$/, '') + '/_matrix/client/v3' + path, {
    method,
    headers: { 'Content-Type': 'application/json', ...(token ? { Authorization: 'Bearer ' + token } : {}) },
    body: body ? JSON.stringify(body) : undefined,
  });
  const data = await res.json().catch(() => ({}));
  if (!res.ok) throw Object.assign(new Error(data.error || `HTTP ${res.status}`), { errcode: data.errcode });
  return data;
}
(async () => {
  let userId;
  try {
    ({ access_token: token, user_id: userId } = await call('POST', '/login', {
      type: 'm.login.password',
      identifier: { type: 'm.id.user', user },
      password,
      initial_device_display_name: 'purrlor command line',
    }));
  } catch (err) {
    console.error(`Couldn't log in as ${user}: ${err.message}`);
    process.exit(1);
  }
  const alias = `#purrlor-emotes:${userId.slice(userId.indexOf(':') + 1)}`;
  try {
    try {
      const { room_id: existing } = await call('GET', '/directory/room/' + encodeURIComponent(alias));
      console.log(`The emote library is already set up: ${alias} (${existing}).`);
      return;
    } catch (err) {
      if (err.errcode !== 'M_NOT_FOUND') throw err;
    }
    const { room_id: roomId } = await call('POST', '/createRoom', {
      name: 'Emote library',
      topic: 'Emotes and stickers everyone on this server can use.',
      room_alias_name: 'purrlor-emotes',
      visibility: 'private',
      creation_content: { type: 'xyz.nekous.emote_library' },
      power_level_content_override: {
        users_default: 0,
        events_default: 50,
        state_default: 50,
        invite: 50,
        kick: 50,
        ban: 50,
        redact: 50,
        events: {
          'im.ponies.room_emotes': 0,
          'xyz.nekous.emote_moderation': 50,
          'm.room.power_levels': 50,
        },
      },
      initial_state: [
        { type: 'm.room.join_rules', state_key: '', content: { join_rule: 'public' } },
        { type: 'm.room.history_visibility', state_key: '', content: { history_visibility: 'shared' } },
        { type: 'm.room.guest_access', state_key: '', content: { guest_access: 'forbidden' } },
      ],
    });
    console.log(`Created the emote library: ${alias} (${roomId}). ${userId} owns it.`);
  } catch (err) {
    console.error(`Couldn't set up the emote library: ${err.message}`);
    process.exitCode = 1;
  } finally {
    await call('POST', '/logout', {}).catch(() => {});
  }
})();
