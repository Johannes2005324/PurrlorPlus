# --- The admin control socket (docs/admin-control.md, docs/admin.md) ---------------------------------
# `pages`, `takedown`, `reports` and `audit` talk to the token server over a Unix socket only root
# can open: no password, nothing on the network. Everything an admin types goes to it as a
# --data-urlencode form field (never into a URL or JSON by hand), user names are checked here as
# well as there, and every change needs a reason, which the server writes to its audit log.

control_sock() {
  local dir="${PURRLOR_CONTROL_DIR:-}"
  [ -n "$dir" ] || dir="$(env_get PURRLOR_CONTROL_DIR)"
  printf '%s/purrlor.sock' "${dir:-/run/purrlor}"
}

# check_control_sock -> returns only if the socket is where it should be and private: neither it nor
# its directory a symlink (which could send the admin password somewhere else), and neither open to
# other users. The token server sets 0700 and 0600 itself every time it starts.
check_control_sock() {
  local sock dir mode path
  sock="$(control_sock)"
  dir="$(dirname "$sock")"
  if [ -L "$dir" ] || [ -L "$sock" ]; then
    die "Refusing: $dir or $sock is a symlink. The control socket's directory must be a real one; look at what put it there."
  fi
  for path in "$dir" "$sock"; do
    [ -e "$path" ] || continue
    mode="$(stat -c '%a' "$path" 2>/dev/null || true)"
    case "$mode" in
      ''|*00) ;;
      *) die "Refusing: $path is open to other users (mode $mode). 'purrlor restart token-server' makes it private again; check what changed it." ;;
    esac
  done
}

# ctl METHOD PATH [curl form args...] -> prints the server's answer; fails unless it went through.
# A 207 (some deletions failed) is printed and counts as done: the answer says which.
ctl() {
  local method="$1" path="$2" out code body
  shift 2
  check_control_sock
  local args=(-sS -m "${CTL_TIMEOUT:-300}" --unix-socket "$(control_sock)" -H 'Accept: text/plain'
    --data-urlencode "actor=${SUDO_USER:-root}")
  [ "$method" = GET ] && args+=(-G)
  out="$(curl "${args[@]}" "$@" -w '\n%{http_code}' "http://purrlor$path")" \
    || die "Couldn't talk to the control socket ($(control_sock)). Is the token server running ('purrlor status')? Its CONTROL_SOCKET must not be empty."
  code="${out##*$'\n'}"
  body="${out%$'\n'*}"
  # The server already strips control characters from what it says; this is the same again here, in
  # case anything else ever answers on that socket. Newlines and tabs stay.
  [ -z "$body" ] || printf '%s\n' "$body" | LC_ALL=C tr -d '\000-\010\013-\037\177'
  case "$code" in
    200|207) return 0 ;;
    *) return 1 ;;
  esac
}

# parse_opts ARGS... -> REASON, ASSUME_YES, LIMIT, ALL, PAGES_ONLY and the rest in POS.
# Anything after a bare -- is never an option, so a name or file link can't be mistaken for one.
REASON=""; ASSUME_YES=0; LIMIT=""; ALL=0; PAGES_ONLY=0; POS=()
parse_opts() {
  REASON=""; ASSUME_YES=0; LIMIT=""; ALL=0; PAGES_ONLY=0; POS=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --reason) [ $# -ge 2 ] || die "--reason needs the reason after it."; REASON="$2"; shift 2 ;;
      --reason=*) REASON="${1#--reason=}"; shift ;;
      --limit) [ $# -ge 2 ] || die "--limit needs a number after it."; LIMIT="$2"; shift 2 ;;
      --limit=*) LIMIT="${1#--limit=}"; shift ;;
      --yes|-y) ASSUME_YES=1; shift ;;
      --pages) PAGES_ONLY=1; shift ;;
      --) shift; POS+=("$@"); break ;;
      -*) die "Unknown option: $1" ;;
      *) POS+=("$1"); shift ;;
    esac
  done
  if [ -n "$LIMIT" ]; then printf '%s' "$LIMIT" | grep -Eq '^[0-9]{1,5}$' || die "--limit must be a number."; fi
}

# need_reason -> REASON, one line: from --reason, or asked for at a terminal.
need_reason() {
  if [ -z "$REASON" ]; then
    [ -t 0 ] || die "This needs a reason: add --reason \"why\" (it goes in the audit log)."
    read -r -p "Reason (goes in the audit log): " REASON
  fi
  REASON="$(printf '%s' "$REASON" | tr -d '\000-\037\177' | sed -E 's/^ +//; s/ +$//')"
  [ -n "$REASON" ] || die "A reason is needed."
}

# confirm MESSAGE -> returns only if the admin typed yes (or gave --yes); nothing has changed before it.
confirm() {
  [ "$ASSUME_YES" -eq 1 ] && return 0
  [ -t 0 ] || die "Run this at a terminal so it can ask you to confirm, or add --yes."
  printf '%s\n' "$1"
  local answer
  read -r -p "Type yes to go ahead: " answer
  [ "$answer" = yes ] || die "Cancelled. Nothing was changed."
}

# user_arg NAME -> NAME if it can only be a user name: no slash, no dots-only, no option look.
user_arg() {
  printf '%s' "${1:-}" | grep -Eq '^@?[A-Za-z0-9_=+][A-Za-z0-9._=+-]*(:[A-Za-z0-9.:-]+)?$' \
    || die "'${1:-}' isn't a user name (try luna, @luna or @luna:server)."
  printf '%s' "$1"
}

# file_arg TARGET -> TARGET if it's an mxc:// URL or an http(s) link, with nothing odd in it.
file_arg() {
  printf '%s' "${1:-}" | grep -Eq '^(mxc|https?)://[^[:space:][:cntrl:]]+$' \
    || die "'${1:-}' isn't a file: give its mxc:// address or the public media link."
  printf '%s' "$1"
}

# ctl_admin METHOD PATH [form args...] -> ctl, with the homeserver admin's account and password asked
# for first. The password goes in on standard input, never on a command line.
ctl_admin() {
  local method="$1" path="$2"
  shift 2
  ask_admin_credentials
  printf '%s' "$PURRLOR_ADMIN_PASSWORD" | ctl "$method" "$path" --data-urlencode "adminUser=$PURRLOR_ADMIN_USER" --data-urlencode 'adminPassword@-' "$@"
}

# cmd_peers: the Purrlor instances this one federates with (docs/federation.md).
cmd_peers() {
  local usage="Usage: purrlor peers [list] | add <its address> | remove <its server name> | sync
  (add and remove take --reason \"why\"; add --yes to skip the confirmation)"
  need_root peers "$@"
  local action="${1:-list}"
  [ "$#" -eq 0 ] || shift
  parse_opts "$@"
  case "$action" in
    list)
      [ "${#POS[@]}" -eq 0 ] || die "$usage"
      ctl GET /peers
      ;;
    add)
      [ "${#POS[@]}" -eq 1 ] || die "$usage"
      local address="${POS[0]}"
      printf '%s' "$address" | grep -Eq '^(https://)?[A-Za-z0-9.-]+(:[0-9]{1,5})?/?$'         || die "'$address' isn't an instance's address: give its name (purr.example) or https:// address, nothing after it."
      need_reason
      confirm "Federate with $address: its people and public Spaces show here (Everyone, Discover, and the
public web for people who opted in), and this server's bot joins its public rooms to read them."
      CTL_TIMEOUT=60 ctl POST /peers/add --data-urlencode "url=$address" --data-urlencode "reason=$REASON"
      ;;
    remove)
      [ "${#POS[@]}" -eq 1 ] || die "$usage"
      local server="${POS[0]}"
      printf '%s' "$server" | grep -Eq '^[A-Za-z0-9.-]+(:[0-9]{1,5})?$' || die "'$server' isn't a server name ('purrlor peers' lists them)."
      need_reason
      confirm "Stop federating with $server: the bot leaves its rooms, and its people and Spaces disappear
from Everyone, Discover and the public web here."
      CTL_TIMEOUT=600 ctl POST "/peers/remove/$server" --data-urlencode "reason=$REASON"
      ;;
    sync)
      [ "${#POS[@]}" -eq 0 ] || die "$usage"
      echo "Reading each peer's directory and joining what's new (this can take a few minutes)..."
      CTL_TIMEOUT=1800 ctl POST /peers/sync
      ;;
    *) die "$usage" ;;
  esac
}

cmd_pages() {
  local usage="Usage: purrlor pages list | show <name> | hide <name> | unhide <name> | off <name> | on <name>
  (hide and off take --reason \"why\"; add --yes to skip the confirmation)"
  need_root pages "$@"
  local action="${1:-}"
  [ -n "$action" ] || die "$usage"
  shift
  parse_opts "$@"
  local id
  case "$action" in
    list)
      [ "${#POS[@]}" -eq 0 ] || die "$usage"
      ctl GET /pages
      ;;
    show)
      [ "${#POS[@]}" -eq 1 ] || die "$usage"
      id="$(user_arg "${POS[0]}")"
      ctl GET "/pages/$id"
      ;;
    hide|off)
      [ "${#POS[@]}" -eq 1 ] || die "$usage"
      id="$(user_arg "${POS[0]}")"
      need_reason
      if [ "$action" = hide ]; then
        confirm "Hide $id's page AND their Global posts from everyone who isn't signed in."
        ctl POST "/pages/$id/hide" --data-urlencode "reason=$REASON"
      else
        confirm "Keep $id's page off the public web, whatever their own switch says (their Global posts stay public)."
        ctl POST "/pages/$id/public-off" --data-urlencode "reason=$REASON"
      fi
      ;;
    unhide|on)
      [ "${#POS[@]}" -eq 1 ] || die "$usage"
      id="$(user_arg "${POS[0]}")"
      local route=unhide
      [ "$action" = on ] && route=public-on
      ctl POST "/pages/$id/$route" --data-urlencode "reason=$REASON"
      ;;
    *) die "$usage" ;;
  esac
}

cmd_takedown() {
  local usage="Usage: purrlor takedown file <mxc-or-link>... | user <name> | album <name> <album> | restore <mxc-or-link>... | list | run
  (all but list take --reason \"why\"; add --yes to skip the confirmation)"
  need_root takedown "$@"
  local action="${1:-}"
  [ -n "$action" ] || die "$usage"
  shift
  parse_opts "$@"
  local id target
  local form=()
  case "$action" in
    file|restore)
      [ "${#POS[@]}" -ge 1 ] || die "$usage"
      for target in "${POS[@]}"; do form+=(--data-urlencode "target=$(file_arg "$target")"); done
      need_reason
      if [ "$action" = file ]; then
        confirm "Block ${#POS[@]} file(s) on the public web now, and queue them for deletion from the homeserver."
        ctl POST /takedown/media ${form[@]+"${form[@]}"} --data-urlencode "reason=$REASON"
      else
        ctl POST /media/unblock ${form[@]+"${form[@]}"} --data-urlencode "reason=$REASON"
      fi
      ;;
    user)
      [ "${#POS[@]}" -eq 1 ] || die "$usage"
      id="$(user_arg "${POS[0]}")"
      need_reason
      confirm "Block and queue for deletion every file the public web serves for $id (their page and posts stay up)."
      ctl POST "/takedown/user/$id" --data-urlencode "reason=$REASON"
      ;;
    album)
      [ "${#POS[@]}" -eq 2 ] || die "$usage"
      id="$(user_arg "${POS[0]}")"
      [ -n "${POS[1]}" ] || die "$usage"
      need_reason
      confirm "Block and queue for deletion the album '${POS[1]}' on $id's page."
      ctl POST "/takedown/album/$id" --data-urlencode "album=${POS[1]}" --data-urlencode "reason=$REASON"
      ;;
    list)
      [ "${#POS[@]}" -eq 0 ] || die "$usage"
      ctl GET /media
      ;;
    run)
      [ "${#POS[@]}" -eq 0 ] || die "$usage"
      need_reason
      confirm "Delete every queued file from the homeserver for good (needs the homeserver admin's password)."
      ctl_admin POST /deletions/run --data-urlencode "reason=$REASON"
      ;;
    *) die "$usage" ;;
  esac
}

# cmd_ips [seconds]: records what addresses reach the token server for that long (default 60, at
# most 240), then prints them by hop with what it means. Browse the site meanwhile. Nothing is
# recorded except while this runs, and the token server keeps none of it afterwards.
cmd_ips() {
  local usage="Usage: purrlor ips [seconds]   (default 60, at most 240; browse the site while it watches)"
  need_root ips "$@"
  [ "$#" -le 1 ] || die "$usage"
  local seconds="${1:-60}"
  printf '%s' "$seconds" | grep -Eq '^[0-9]{1,3}$' && [ "$seconds" -ge 1 ] && [ "$seconds" -le 240 ] || die "$usage"
  echo "Watching for ${seconds}s. Open the site now (the global feed, a profile), from a phone off Wi-Fi too if you can..."
  CTL_TIMEOUT=$((seconds + 30)) ctl POST /ips/watch --data-urlencode "seconds=$seconds"
}

# cmd_stats: totals only (docs/admin.md). The registered count comes from the homeserver, so it asks
# for its admin; online and public-page counts are the token server's own.
cmd_stats() {
  local usage="Usage: purrlor stats   (asks for the homeserver admin's password)"
  need_root stats "$@"
  [ "$#" -eq 0 ] || die "$usage"
  ctl_admin POST /stats
}

cmd_reports() {
  local usage="Usage: purrlor reports [--pages] [--limit N]   (asks for the homeserver admin's password)"
  need_root reports "$@"
  parse_opts "$@"
  [ "${#POS[@]}" -eq 0 ] || die "$usage"
  local form=()
  [ -z "$LIMIT" ] || form+=(--data-urlencode "limit=$LIMIT")
  [ "$PAGES_ONLY" -eq 0 ] || form+=(--data-urlencode 'only=pages')
  ctl_admin POST /reports ${form[@]+"${form[@]}"}
  echo
  echo "Copyright complaints arrive by email at the address in the terms, not here: block the file with 'purrlor takedown file'."
}

cmd_audit() {
  local usage="Usage: purrlor audit [how many, default 50]"
  need_root audit "$@"
  parse_opts "$@"
  [ "${#POS[@]}" -le 1 ] || die "$usage"
  local n="${LIMIT:-${POS[0]:-50}}"
  printf '%s' "$n" | grep -Eq '^[0-9]{1,4}$' || die "$usage"
  ctl GET /audit --data-urlencode "limit=$n"
}

cmd_bugs() {
  local usage="Usage: purrlor bugs [project] [--open] [--limit N]"
  need_root bugs "$@"
  local args=() open=0 arg
  for arg in "$@"; do
    if [ "$arg" = --open ]; then open=1; else args+=("$arg"); fi
  done
  parse_opts "${args[@]}"
  [ "${#POS[@]}" -le 1 ] || die "$usage"
  local n="${LIMIT:-50}" project="${POS[0]:-}"
  printf '%s' "$n" | grep -Eq '^[0-9]{1,4}$' || die "$usage"
  [ -z "$project" ] || printf '%s' "$project" | grep -Eq '^[A-Za-z0-9][A-Za-z0-9_-]{0,31}$' || die "$usage"
  ctl GET /bugs --data-urlencode "limit=$n" ${project:+--data-urlencode "project=$project"} $([ "$open" = 1 ] && echo --data-urlencode open=1)
}

# The dispatcher and the `exit` after it are one command (same line as `esac`), so bash has read
# all of it before running any of it — a script updated underneath it can't be half-read.
case "${1:-help}" in
  help|-h|--help) cmd_help ;;
  info) cmd_info ;;
  status) cmd_status ;;
  logs) shift; compose logs -f --tail 200 "$@" ;;
  restart) shift; compose restart "$@" ;;
  update) cmd_update ;;
  update-apply) cmd_update_apply ;;
  doctor) cmd_doctor ;;
  backup) shift; cmd_backup "$@" ;;
  restore) shift; cmd_restore "$@" ;;
  alerts) shift; cmd_alerts "$@" ;;
  errors) shift; cmd_errors "$@" ;;
  metrics) shift; cmd_metrics "$@" ;;
  new-invite-code) cmd_new_invite_code ;;
  open-signups) cmd_signups open ;;
  close-signups) cmd_signups close ;;
  email) shift; cmd_email "$@" ;;
  email-apply) cmd_email_apply ;;
  media) shift; cmd_media "$@" ;;
  user) shift; cmd_user "$@" ;;
  admin) shift; cmd_admin "$@" ;;
  emotes) shift; cmd_emotes "$@" ;;
  pages) shift; cmd_pages "$@" ;;
  peers) shift; cmd_peers "$@" ;;
  takedown) shift; cmd_takedown "$@" ;;
  reports) shift; cmd_reports "$@" ;;
  audit) shift; cmd_audit "$@" ;;
  bugs) shift; cmd_bugs "$@" ;;
  stats) shift; cmd_stats "$@" ;;
  ips) shift; cmd_ips "$@" ;;
  matrix-dns) write_matrix_resolv ;;
  *) warn "Unknown command: $1"; echo; cmd_help; exit 1 ;;
esac; exit $?
