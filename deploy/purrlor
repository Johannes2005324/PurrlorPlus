#!/usr/bin/env bash
# `purrlor` — day-to-day management of a Purrlor install. deploy/setup.sh links this into
# /usr/local/bin, so it works from anywhere on the server. Run `purrlor help` for the commands.
#
# Everything here is a thin, readable wrapper around docker compose and .env — nothing it does is
# hidden; each command says what it's running.

set -euo pipefail

REPO_ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
cd "$REPO_ROOT"

say()  { printf '==> %s\n' "$1"; }
warn() { printf '!!  %s\n' "$1" >&2; }
die()  { warn "$1"; exit 1; }

[ -f .env ] || die "No .env in $REPO_ROOT — Purrlor isn't installed here yet. Run: sudo bash deploy/setup.sh"

env_get() { grep "^$1=" .env 2>/dev/null | tail -n1 | cut -d= -f2- || true; }

# Same as setup.sh's: replace the line for KEY instead of appending a second one.
env_set() {
  local __tmp
  __tmp="$(mktemp)"
  grep -v "^$1=" .env > "$__tmp" || true
  printf '%s=%s\n' "$1" "$2" >> "$__tmp"
  cat "$__tmp" > .env
  rm -f "$__tmp"
  chmod 600 .env
}

has_matrix() { [ "$(env_get COMPOSE_PROFILES)" = matrix ]; }

# The homeserver container's DNS: this server's own resolvers first, so names only the local
# network knows (a mail server on the LAN, say) resolve the same inside it as out here; public
# ones after, as a fallback. Not Docker's embedded resolver, which upstream documents as causing
# federation lookup timeouts. Written per server, so it isn't in git.
MATRIX_RESOLV="$REPO_ROOT/matrix-resolv.conf"
write_matrix_resolv() {
  local src=/etc/resolv.conf key ns picked=() out
  # systemd-resolved's stub (127.0.0.53) can't be reached from a container; this lists its upstreams.
  if [ -f /run/systemd/resolve/resolv.conf ] && grep -q '^nameserver 127\.' /etc/resolv.conf; then
    src=/run/systemd/resolve/resolv.conf
  fi
  while read -r key ns _; do
    [ "$key" = nameserver ] || continue
    case "$ns" in 127.*|::1|0.0.0.0|fe80:*) continue ;; esac
    if [ "${#picked[@]}" -lt 2 ]; then picked+=("$ns"); fi
  done < "$src"
  # Resolvers are tried in order, three at most — a public one always gets a slot.
  for ns in 1.1.1.1 8.8.8.8; do
    [ "${#picked[@]}" -lt 3 ] || break
    case " ${picked[*]} " in *" $ns "*) ;; *) picked+=("$ns") ;; esac
  done
  out="# Written by purrlor from this server's DNS settings ($src) — don't edit, it's rewritten on
# every start. The homeserver container's /etc/resolv.conf: see write_matrix_resolv in deploy/purrlor."
  for ns in "${picked[@]}"; do out="$out
nameserver $ns"; done
  printf '%s\n' "$out" > "$MATRIX_RESOLV"
}

compose() {
  local __profile=()
  if has_matrix; then __profile=(--profile matrix); fi
  if has_matrix && [ "${1:-}" = up ]; then write_matrix_resolv; fi
  docker compose -f deploy/docker-compose.yml --env-file .env "${__profile[@]}" "$@"
}

need_root() {
  [ "$(id -u)" -eq 0 ] || die "This one needs root: sudo purrlor $*"
}

host_of() { printf '%s' "$1" | sed -E 's#^[a-z]+://##; s#[:/].*$##'; }

# Same list and test as setup.sh: a proxied Cloudflare record resolves to Cloudflare, not here.
CLOUDFLARE_V4="173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18
108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15
104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22"
ip_to_int() { local IFS=.; set -- $1; echo $(( ($1 << 24) + ($2 << 16) + ($3 << 8) + $4 )); }
cloudflare_ip() {
  local ip range net bits mask
  printf '%s' "$1" | grep -Eq '^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$' || return 1
  ip="$(ip_to_int "$1")"
  for range in $CLOUDFLARE_V4; do
    net="$(ip_to_int "${range%/*}")"; bits="${range#*/}"
    mask=$(( (0xFFFFFFFF << (32 - bits)) & 0xFFFFFFFF ))
    [ $(( ip & mask )) -eq $(( net & mask )) ] && return 0
  done
  return 1
}

