cmd_info() {
  if [ -f .install-summary ]; then cat .install-summary; else warn "No saved summary — this install predates it. Settings are in $REPO_ROOT/.env."; fi
}

# cmd_status [grace seconds]: what's running, and whether each part answers. Right after containers
# are recreated (update), a service can still be starting — Node takes a few seconds to listen —
# so the grace period keeps asking until then rather than reporting a FAIL that isn't one.
cmd_status() {
  local grace="${1:-0}"
  compose ps
  echo
  local ok=0 a deadline=$((SECONDS + grace))
  a="$(env_get BIND_ADDR)"; a="${a:-127.0.0.1}"
  [ "$grace" -gt 0 ] && echo "  (giving everything up to ${grace}s to start answering)"
  # answers URL: whether it responds, asking again every 2s until the grace period is over.
  answers() {
    until curl -fsS -m 5 "$1" >/dev/null 2>&1; do
      [ "$SECONDS" -lt "$deadline" ] || return 1
      sleep 2
    done
  }
  answers http://$a:8080/ && echo "  ok   web" || { echo "  FAIL web"; ok=1; }
  answers http://$a:3001/health && echo "  ok   token-server" || { echo "  FAIL token-server"; ok=1; }
  answers http://$a:3002/health && echo "  ok   push-gateway" || { echo "  FAIL push-gateway"; ok=1; }
  answers http://$a:7880/ && echo "  ok   livekit" || { echo "  FAIL livekit"; ok=1; }
  if has_matrix; then
    answers http://$a:8008/_matrix/client/versions && echo "  ok   matrix" || { echo "  FAIL matrix"; ok=1; }
  fi
  [ "$ok" -eq 0 ] || echo "
Something isn't answering — 'purrlor logs <service>' shows why."
}

cmd_doctor() {
  local app livekit homeserver ip fails=0
  app="$(host_of "$(env_get ALLOWED_ORIGINS | cut -d, -f1)")"
  livekit="$(host_of "$(env_get PURRLOR_LIVEKIT_URL)")"
  homeserver="$(env_get PURRLOR_HOMESERVER_URL)"
  ip="$(env_get HOST_IP)"
  [ -n "$app" ] && [ -n "$ip" ] || die ".env is missing ALLOWED_ORIGINS or HOST_IP — re-run setup.sh."

  check() {
    local label="$1"; shift
    if "$@" >/dev/null 2>&1; then echo "  ok   $label"; else echo "  FAIL $label"; fails=$((fails + 1)); fi
  }
  local edge; edge="$(env_get PURRLOR_EDGE)"
  # With nginx on another server, through real DNS (it's that server being checked); otherwise
  # straight at this one.
  get() {
    if [ "$edge" = true ]; then curl -fsS -m 10 --noproxy '*' "https://$1$2"
    else curl -fsS -m 10 --noproxy '*' --resolve "$1:443:$ip" "https://$1$2"; fi
  }
  has() { local b; b="$(get "$1" "$2")" && grep -q -- "$3" <<<"$b"; }

  # What an HTTP status means for this layout — the part of the chain that's wrong.
  status_hint() {
    case "$1" in
      000) echo "no answer at all (DNS, a firewall, or nothing listening on 443)" ;;
      TIMEOUT) local b; b="$(env_get BIND_ADDR)"
               echo "timed out — something took the request but never answered: usually nginx can't reach the Purrlor server${b:+ at $b} and is waiting on it" ;;
      401) echo "asks for a login — this name reaches some other service, not Purrlor (an old server block?)" ;;
      301|302|307|308) echo "redirected (to ${2:-?}) — behind Cloudflare, usually SSL/TLS mode 'Flexible': set it to 'Full (strict)'" ;;
      400) echo "bad request — often a plain-HTTP port reached over HTTPS, or the reverse" ;;
      403) echo "forbidden — a Cloudflare security rule or an nginx allow/deny" ;;
      404) echo "not found — nginx has no location for this path (or an old server block for this name is winning)" ;;
      502|503|504) echo "nginx can't reach the Purrlor service behind it — check its proxy_pass address and that it can reach it" ;;
      520|521|522|523|524) echo "Cloudflare can't reach your nginx server (521: refused, 522/524: timed out, 523: unreachable)" ;;
      525|526) echo "Cloudflare and nginx disagree about TLS — the certificate on nginx, or Cloudflare's SSL/TLS mode" ;;
      *) echo "HTTP $1" ;;
    esac
  }

  # probe LABEL HOST PATH [TEXT] — fetches it, and on failure says which status came back and what
  # that points at, instead of a bare FAIL.
  probe() {
    local label="$1" host="$2" path="$3" want="${4:-}" body code loc
    body="$(mktemp)"
    local args=(-sS -m 10 --noproxy '*' -o "$body" -w '%{http_code} %{redirect_url}')
    [ "$edge" = true ] || args+=(--resolve "$host:443:$ip")
    # A variable, not `read`: curl's -w output has no newline, and read's non-zero exit at the end
    # of input would end the script under set -e.
    local out rc=0
    out="$(curl "${args[@]}" "https://$host$path" 2>/dev/null)" || rc=$?
    code="${out%% *}"; loc="${out#* }"
    [ -n "$code" ] || code=000
    # curl's exit 28 is its own timeout: reached, but no answer — a different problem from refused.
    if [ "$code" = 000 ] && [ "$rc" = 28 ]; then code=TIMEOUT; fi
    if [ "${code:0:1}" = 2 ] && { [ -z "$want" ] || grep -q -- "$want" "$body"; }; then
      echo "  ok   $label"
    else
      fails=$((fails + 1))
      if [ "${code:0:1}" = 2 ]; then
        echo "  FAIL $label — answered, but not by Purrlor (the page doesn't look right: an old server block?)"
      else
        echo "  FAIL $label — $(status_hint "$code" "$loc")"
      fi
    fi
    rm -f "$body"
  }
  dns() {
    local r; r="$(getent ahostsv4 "$1" 2>/dev/null | awk '{print $1}' | head -n1)"
    [ -n "$r" ] || return 1
    # Resolving at all is enough with nginx elsewhere (or behind Cloudflare's proxy).
    [ "$edge" = true ] || [ "$r" = "$ip" ] || cloudflare_ip "$r"
  }

  if [ "$edge" = true ]; then say "DNS (should resolve — to your nginx server or Cloudflare)"
  else say "DNS (should all point at $ip, or Cloudflare)"; fi
  check "$app" dns "$app"
  [ -n "$livekit" ] && check "$livekit" dns "$livekit"
  [ -n "$homeserver" ] && check "$(host_of "$homeserver")" dns "$(host_of "$homeserver")"

  say "HTTPS"
  probe "app at https://$app" "$app" /config.json livekitUrl
  probe "token server (https://$app/api/livekit)" "$app" /api/livekit/config botUserId
  probe "push gateway (https://$app/api/push)" "$app" /api/push/health ok
  [ -n "$livekit" ] && probe "voice server at https://$livekit" "$livekit" / OK
  if [ -n "$homeserver" ]; then
    probe "homeserver at $homeserver" "$(host_of "$homeserver")" /_matrix/client/versions versions
    if has_matrix; then
      # Where other servers look: the server name (the bare domain, or matrix.<domain>).
      local sname; sname="$(env_get MATRIX_SERVER_NAME)"
      probe "federation over 443 (https://${sname:-$(host_of "$homeserver")}/.well-known/matrix/server)" "${sname:-$(host_of "$homeserver")}" /.well-known/matrix/server m.server
    fi
  fi
  if has_matrix && [ -n "$homeserver" ] && [ "$edge" != true ]; then
    local mhost; mhost="$(host_of "$homeserver")"
    check "federation (port 8448)" curl -fsS -m 10 --noproxy '*' --resolve "$mhost:8448:$ip" "https://$mhost:8448/_matrix/federation/v1/version"
  fi

  say "Certificate"
  local days
  local target="$ip"; [ "$edge" = true ] && target="$app"
  days="$(echo | openssl s_client -connect "$target:443" -servername "$app" 2>/dev/null | openssl x509 -noout -enddate 2>/dev/null | cut -d= -f2)"
  if [ -n "$days" ]; then echo "  ok   valid until $days (renews automatically)"; else echo "  FAIL couldn't read the certificate"; fails=$((fails + 1)); fi

  echo
  if [ "$fails" -eq 0 ]; then
    echo "Everything answers from the outside."
  elif [ "$edge" = true ]; then
    local bind; bind="$(env_get BIND_ADDR)"
    cat <<ADVICE
$fails check(s) failed. With nginx on another server, that's almost always its config:
  - The page loads but /api/livekit or /api/push fail: the app's server block is missing the
    'location /api/livekit/' and 'location /api/push/' blocks.
  - A whole name fails (livekit., matrix.): nginx has no server block for it, or it points
    somewhere other than $bind.
The complete config for your nginx server is in $REPO_ROOT/deploy/edge/purrlor.conf (and the
optional voice relay in voice-relay.stream) — compare it with what's there, or use it in place of the old
files. On the nginx server, 'nginx -t' must pass: with an error, a reload is refused and the old
config stays live. 'curl http://$bind:3001/health' there shows it can reach this server.
ADVICE
  else
    cat <<ADVICE
$fails check(s) failed. The usual causes:
  - DNS: a record isn't pointing at $ip yet (or a Cloudflare record is proxied — use DNS only).
  - Firewall: your provider's firewall is blocking 80/443 (or 8448 for federation).
  - A service is down: 'purrlor status', then 'purrlor logs <service>'.
Voice needs 7881/tcp and 7882/udp open too; those can't be tested from here.
ADVICE
  fi
}

cmd_update() {
  need_root update
  say "Fetching the latest Purrlor"
  git pull --ff-only || die "git pull couldn't fast-forward — there are local changes in $REPO_ROOT. Check 'git status'."
  # The pull may have just replaced this very script, which bash is still reading from disk as it
  # runs. Carry on in the fresh copy instead — which also means the rest of the update is always
  # the newest version of these steps.
  exec "$REPO_ROOT/deploy/purrlor" update-apply
}

cmd_update_apply() {
  need_root update
  # An install from before errors and metrics: the services read the token when they're recreated below.
  [ -n "$(env_get PURRLOR_METRICS_TOKEN)" ] || env_set PURRLOR_METRICS_TOKEN "$(openssl rand -hex 32)"
  say "Downloading the new images and restarting onto them"
  if compose pull; then
    compose up -d
  else
    warn "Couldn't download the prebuilt images — building them here instead (needs ~4 GB of memory)."
    compose up -d --build
  fi
  say "Removing images the update left behind"
  docker image prune -f >/dev/null
  echo
  cmd_status 60
}

# ---------------------------------------------------------------------------
# Backups and restoring (docs/deployment.md, "Backups")
# ---------------------------------------------------------------------------

BACKUP_DIR="$REPO_ROOT/backups"
# Where purrlor keeps what it notices between runs (the last alert sent, a failed nightly backup).
# The overrides are for deploy/test.
STATE_DIR="${PURRLOR_STATE_DIR:-/var/lib/purrlor}"
CRON_D="${PURRLOR_CRON_D:-/etc/cron.d}"
PERIODIC="${PURRLOR_PERIODIC:-/etc/periodic}"
# What's in a backup, so a restore knows what it's looking at. 1 (no MANIFEST): .env, the
# homeserver's data and its mail settings. 2: also the token server's moderation records (hidden
# pages, takedowns, deletions, the audit log), the push gateway's reminders and the install summary.
BACKUP_FORMAT=2

# Settings that describe this machine rather than the install. A restore keeps this server's own,
# so a backup from another server can't point this one at that one's address, network, proxy,
# media disk, alerts or backup copies.
MACHINE_KEYS=(HOST_IP BIND_ADDR MATRIX_MEDIA_DIR PURRLOR_CONTROL_DIR CONTAINER_PROXY OUTBOUND_PROXY
  OUTBOUND_NO_PROXY PURRLOR_EDGE REAL_IP_FROM PURRLOR_ALERT_URL PURRLOR_BACKUP_COPY_TO PURRLOR_BACKUP_KEEP)

# While a backup or restore has services stopped on purpose, alerts don't report them as down.
# A marker older than two hours is ignored, in case whatever wrote it was killed before removing it.
maintenance_on() { mkdir -p "$STATE_DIR" && touch "$STATE_DIR/maintenance"; }
maintenance_off() { rm -f "$STATE_DIR/maintenance"; }
in_maintenance() { [ -f "$STATE_DIR/maintenance" ] && [ -z "$(find "$STATE_DIR/maintenance" -mmin +120 2>/dev/null)" ]; }

# service_cid SERVICE -> its container's id, running or not; empty when there isn't one.
service_cid() { compose ps -a -q "$1" 2>/dev/null || true; }

# A service's /data out to /backup, run in a throwaway container sharing its volume. Not the token
# server's media-cache: copies of files the homeserver has, and emptied on every start anyway.
read -r -d '' DATA_OUT <<'SH' || true
set -e
cd /data
for f in * .[!.]*; do
  [ -e "$f" ] || continue
  [ "$f" != media-cache ] || continue
  cp -a "$f" /backup/
done
SH

# And back in from /restore: what's there now goes first, so nothing newer than the backup stays.
read -r -d '' DATA_IN <<'SH' || true
set -e
find /data -mindepth 1 -maxdepth 1 -exec rm -rf {} +
cp -a /restore/. /data/
SH

# The homeserver's data back in from /restore/matrix-db.tar.gz. The backup holds media as a real
# folder wherever it lived; it goes where this install keeps it now: MOVED=1 is the folder
# 'purrlor media move' set up (mounted at /purrlor-media, linked from the database), 0 is inside
# the database. It's unpacked beside where it ends up, so putting it in place is a rename rather
# than a second copy of every upload, and nothing already there is touched until it has unpacked.
read -r -d '' MATRIX_IN <<'SH' || true
set -e
D=/var/lib/continuwuity
if [ "$MOVED" = 1 ]; then S=/purrlor-media/.purrlor-restore; else S=$D/.purrlor-restore; fi
trap 'rm -rf "$S"' EXIT
rm -rf "$S"
mkdir "$S"
tar -xzf /restore/matrix-db.tar.gz -C "$S"
find "$D" -mindepth 1 -maxdepth 1 ! -name .purrlor-restore -exec rm -rf {} +
if [ "$MOVED" = 1 ]; then
  find /purrlor-media -mindepth 1 -maxdepth 1 ! -name .purrlor-restore -exec rm -rf {} +
  if [ -d "$S/media" ]; then
    chown "$(stat -c %u:%g "$S/media")" /purrlor-media
    find "$S/media" -mindepth 1 -maxdepth 1 -exec mv {} /purrlor-media/ \;
    rmdir "$S/media"
  fi
  cp -a "$S/." "$D/"
  ln -s /purrlor-media "$D/media"
else
  find "$S" -mindepth 1 -maxdepth 1 -exec mv {} "$D/" \;
fi
SH

# backup_make DIR [LABEL] -> BACKUP_FILE: everything a rebuilt server needs that git doesn't have.
# The homeserver, token server and push gateway stop together for the copy (seconds, or a minute
# or two with a lot of media), so what they hold agrees; they start again even when it fails.
backup_make() {
  local dir="$1" label="${2:-}" work cid svc failed=""
  mkdir -p "$dir"
  BACKUP_FILE="$dir/purrlor-${label:+$label-}$(date +%Y%m%d-%H%M%S).tar.gz"
  # Beside the backup rather than in /tmp, which may be small or in memory: the homeserver's
  # part holds every upload.
  work="$(mktemp -d "$dir/.purrlor-backup.XXXXXX")"
  cp .env "$work/env"
  if [ -f "$EMAIL_FILE" ]; then cp "$EMAIL_FILE" "$work/matrix-email.env"; fi
  if [ -f .install-summary ]; then cp .install-summary "$work/install-summary"; fi
  # This server's own Terms of Service: not in git, so nothing else keeps a copy.
  if [ -f custom/terms.html ]; then cp custom/terms.html "$work/terms.html"; fi
  local services=(token-server push-gateway)
  if has_matrix; then services=(matrix "${services[@]}"); fi
  say "Stopping ${services[*]} briefly for a consistent copy"
  maintenance_on
  compose stop "${services[@]}"
  if has_matrix; then
    cid="$(service_cid matrix)"
    # -h: when media lives elsewhere ('purrlor media move'), its folder here is a symlink to it —
    # save the files, not the link.
    docker run --rm --volumes-from "$cid" -v "$work:/backup" alpine \
      tar -czhf /backup/matrix-db.tar.gz -C /var/lib/continuwuity . || failed="the homeserver's data"
  fi
  for svc in token-server push-gateway; do
    cid="$(service_cid "$svc")"
    if [ -z "$cid" ]; then warn "There's no $svc container, so its data isn't in this backup."; continue; fi
    mkdir -p "$work/$svc"
    docker run --rm --volumes-from "$cid" -v "$work/$svc:/backup" alpine sh -c "$DATA_OUT" \
      || failed="${failed:+$failed and }the $svc's data"
  done
  compose start "${services[@]}"
  maintenance_off
  if [ -n "$failed" ]; then
    rm -rf "$work"
    die "Couldn't copy $failed (the error is above), so no backup was saved."
  fi
  {
    echo "purrlor-backup $BACKUP_FORMAT"
    echo "created $(date -u +%Y-%m-%dT%H:%M:%SZ)"
    echo "commit $(git -c safe.directory='*' rev-parse --short HEAD 2>/dev/null || echo unknown)"
  } > "$work/MANIFEST"
  # Written under another name and renamed once whole, so a half-written file (a full disk) is
  # never mistaken for a backup — by a restore, or by the nightly clean-up counting what to keep.
  if ! (umask 077 && tar -czf "$BACKUP_FILE.partial" -C "$work" .); then
    rm -rf "$work" "$BACKUP_FILE.partial"
    die "Couldn't write $BACKUP_FILE (is the disk full? 'df -h $dir')."
  fi
  mv "$BACKUP_FILE.partial" "$BACKUP_FILE"
  rm -rf "$work"
}

cmd_backup() {
  case "${1:-}" in
    schedule) shift; cmd_backup_schedule "$@" ;;
    copy-to) shift; cmd_backup_copy_to "$@" ;;
    list) need_root backup; backup_list ;;
    run-scheduled) need_root backup; backup_scheduled ;;
    *)
      need_root backup
      [ "$#" -le 1 ] || die "Usage: purrlor backup [dir]"
      backup_make "${1:-$BACKUP_DIR}"
      say "Saved $BACKUP_FILE ($(du -h "$BACKUP_FILE" | cut -f1))"
      echo "   It contains your secrets (.env) — keep it somewhere safe, and off this server too."
      echo "   To go back to it: sudo purrlor restore $BACKUP_FILE"
      ;;
  esac
}

backup_list() {
  local found
  found="$(ls -1t "$BACKUP_DIR"/purrlor-*.tar.gz 2>/dev/null || true)"
  if [ -z "$found" ]; then say "No backups in $BACKUP_DIR yet. Make one: sudo purrlor backup"; return; fi
  say "Backups in $BACKUP_DIR, newest first ('auto' ones are nightly, 'before-restore' ones were made by a restore):"
  # shellcheck disable=SC2086 # one path per line, none with spaces (they're named here)
  ls -1sht $found | sed 's/^/   /'
}

# cron_put NAME WHEN COMMAND -> runs COMMAND as root, WHEN being daily (03:30) or often (every 5
# minutes). Debian and Ubuntu's cron reads /etc/cron.d; Alpine's runs /etc/periodic/<period>
# instead, where daily is 02:00 and the shortest period is 15 minutes.
cron_put() {
  local name="$1" when="$2" cmd="$3 >> /var/log/purrlor.log 2>&1"
  if [ -d "$CRON_D" ]; then
    local spec='30 3 * * *'; [ "$when" = often ] && spec='*/5 * * * *'
    printf '# Written by purrlor — change it with purrlor (purrlor help), not here.\nPATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin\n%s root %s\n' \
      "$spec" "$cmd" > "$CRON_D/$name"
    chmod 644 "$CRON_D/$name"
  elif [ -d "$PERIODIC" ]; then
    local period=daily; [ "$when" = often ] && period=15min
    printf '#!/bin/sh\n# Written by purrlor — change it with purrlor (purrlor help), not here.\n%s\n' "$cmd" > "$PERIODIC/$period/$name"
    chmod 700 "$PERIODIC/$period/$name"
  else
    die "There's no cron on this server to run it. Install it first (Debian/Ubuntu: apt-get install cron; Alpine: rc-update add crond && rc-service crond start)."
  fi
  # /etc/cron.d can be there without cron itself (other packages put files in it).
  if ! command -v cron >/dev/null 2>&1 && ! command -v crond >/dev/null 2>&1; then
    warn "cron doesn't seem to be installed, so this won't run until it is: apt-get install cron (Alpine: rc-update add crond && rc-service crond start)"
  fi
}
cron_file() { local f; for f in "$CRON_D/$1" "$PERIODIC"/*/"$1"; do [ ! -f "$f" ] || { echo "$f"; return; }; done; }
cron_has() { [ -n "$(cron_file "$1")" ]; }
cron_drop() { rm -f "$CRON_D/$1" "$PERIODIC"/*/"$1"; }

backup_keep() { local k; k="$(env_get PURRLOR_BACKUP_KEEP)"; echo "${k:-7}"; }

cmd_backup_schedule() {
  local usage="Usage: purrlor backup schedule [daily [how many to keep, default 7] | off]"
  need_root backup
  case "${1:-}" in
    "")
      [ "$#" -eq 0 ] || die "$usage"
      if cron_has purrlor-backup; then
        say "Nightly backups are on ($(cron_file purrlor-backup)), keeping the newest $(backup_keep) in $BACKUP_DIR."
      else
        say "Nightly backups are off. Turn them on: sudo purrlor backup schedule daily"
      fi
      local to; to="$(env_get PURRLOR_BACKUP_COPY_TO)"
      if [ -n "$to" ]; then echo "   Each one is also copied to $to."
      else echo "   They stay on this server only. Copy them elsewhere too: sudo purrlor backup copy-to user@host:/path"; fi
      ;;
    daily)
      [ "$#" -le 2 ] || die "$usage"
      local keep="${2:-7}"
      printf '%s' "$keep" | grep -Eq '^[0-9]{1,3}$' && [ "$keep" -ge 1 ] || die "$usage"
      env_set PURRLOR_BACKUP_KEEP "$keep"
      cron_put purrlor-backup daily "$REPO_ROOT/deploy/purrlor backup run-scheduled"
      say "Nightly backups are on: one every night into $BACKUP_DIR, keeping the newest $keep."
      echo "   The homeserver stops for the copy (seconds, or a minute or two with a lot of media)."
      echo "   'purrlor alerts' can tell you when one fails. Its log: /var/log/purrlor.log"
      [ -n "$(env_get PURRLOR_BACKUP_COPY_TO)" ] \
        || echo "   They stay on this server only. Copy them elsewhere too: sudo purrlor backup copy-to user@host:/path"
      ;;
    off)
      [ "$#" -eq 1 ] || die "$usage"
      cron_drop purrlor-backup
      rm -f "$STATE_DIR/backup-failed" "$STATE_DIR/backup-copy-failed"
      say "Nightly backups are off. The ones already saved stay in $BACKUP_DIR."
      ;;
    *) die "$usage" ;;
  esac
}

# backup_scheduled: the nightly run. A failure ends it (die), so the marker that 'purrlor alerts'
# reports is written first and only removed once the backup is saved.
backup_scheduled() {
  local keep old
  keep="$(backup_keep)"
  mkdir -p "$STATE_DIR"
  echo "--- $(date '+%F %T') nightly backup"
  echo "last night's backup failed ($(date '+%F %R')): see /var/log/purrlor.log" > "$STATE_DIR/backup-failed"
  backup_make "$BACKUP_DIR" auto
  rm -f "$STATE_DIR/backup-failed"
  say "Saved $BACKUP_FILE ($(du -h "$BACKUP_FILE" | cut -f1))"
  # Only the nightly ones are cleared out; a backup made by hand is yours to delete.
  for old in $(ls -1t "$BACKUP_DIR"/purrlor-auto-*.tar.gz 2>/dev/null | tail -n +$((keep + 1)) || true); do
    rm -f "$old"
    echo "   removed $old"
  done
  backup_copy_off "$BACKUP_FILE"
}

# remote_dir DEST -> DEST ending in / (or :, for the home folder), for scp to put a file inside it.
remote_dir() { case "$1" in *: | */) printf '%s' "$1" ;; *) printf '%s/' "$1" ;; esac; }

backup_copy_off() {
  local to; to="$(env_get PURRLOR_BACKUP_COPY_TO)"
  [ -n "$to" ] || return 0
  say "Copying it to $to"
  if scp -q -B -o ConnectTimeout=30 "$1" "$(remote_dir "$to")"; then
    rm -f "$STATE_DIR/backup-copy-failed"
  else
    echo "couldn't copy last night's backup to $to ($(date '+%F %R')): see /var/log/purrlor.log" > "$STATE_DIR/backup-copy-failed"
    warn "Couldn't copy it to $to (the error is above). It's still saved here."
  fi
}

cmd_backup_copy_to() {
  local usage="Usage: purrlor backup copy-to user@host:/path   (or 'off')"
  need_root backup
  [ "$#" -eq 1 ] || die "$usage"
  if [ "$1" = off ]; then
    env_set PURRLOR_BACKUP_COPY_TO ""
    rm -f "$STATE_DIR/backup-copy-failed"
    say "Nightly backups stay on this server only now."
    return
  fi
  printf '%s' "$1" | grep -Eq '^[A-Za-z0-9._-]+@[A-Za-z0-9.-]+:[A-Za-z0-9._/~-]*$' || die "$usage"
  command -v scp >/dev/null 2>&1 || die "scp isn't installed: apt-get install openssh-client (Alpine: apk add openssh-client)."
  local probe; probe="$(mktemp)"
  echo "Written by purrlor on $(hostname) to check it can copy backups here. Safe to delete." > "$probe"
  say "Checking that root on this server can copy files to $1"
  # accept-new: the first connection trusts the other server's key and remembers it, so every
  # later copy is checked against it. BatchMode: a password prompt can't wait for anyone at 03:30.
  if ! scp -q -o BatchMode=yes -o StrictHostKeyChecking=accept-new -o ConnectTimeout=30 \
      "$probe" "$(remote_dir "$1")purrlor-copy-test.txt"; then
    rm -f "$probe"
    warn "Couldn't copy to $1 (the error is above). Copies run as root with a key, no password:"
    warn "  sudo ssh-keygen -t ed25519          (if root has no key yet; leave the passphrase empty)"
    warn "  sudo ssh-copy-id ${1%%:*}           (or add /root/.ssh/id_ed25519.pub to its authorized_keys)"
    die "Then run this again. Nothing was changed."
  fi
  rm -f "$probe"
  env_set PURRLOR_BACKUP_COPY_TO "$1"
  say "Each nightly backup will be copied to $1 too (a test file, purrlor-copy-test.txt, is there now)."
  echo "   Old copies there aren't deleted — clear them out on that side, or let its snapshots do it."
  cron_has purrlor-backup || echo "   Nightly backups aren't on yet: sudo purrlor backup schedule daily"
}

# restore_env FROM -> .env from the backup's settings, except this machine's own (MACHINE_KEYS).
restore_env() {
  local pattern tmp
  pattern="^($(IFS='|'; echo "${MACHINE_KEYS[*]}"))="
  tmp="$(mktemp)"
  { grep -vE "$pattern" "$1" || true; grep -E "$pattern" .env || true; } > "$tmp"
  cat "$tmp" > .env
  rm -f "$tmp"
  chmod 600 .env
}

RESTORE_WORK=""
restore_failed() {
  warn "Couldn't put back $2 (the error is above). Purrlor is stopped."
  die "Go back to how things were with: sudo purrlor restore $1"
}

cmd_restore() {
  local usage="Usage: purrlor restore <backup file> [--yes]   ('purrlor backup list' shows them)"
  need_root restore
  parse_opts "$@"
  [ "${#POS[@]}" -eq 1 ] || die "$usage"
  local file="${POS[0]}" format=1 created="" bundled=no media undo svc
  [ -f "$file" ] || die "There's no file at $file. $usage"
  file="$(cd "$(dirname "$file")" && pwd)/$(basename "$file")"

  RESTORE_WORK="$(mktemp -d "$(dirname "$file")/.purrlor-restore.XXXXXX")"
  trap 'rm -rf "$RESTORE_WORK"; maintenance_off' EXIT
  local work="$RESTORE_WORK"
  say "Reading $file"
  tar -xzf "$file" -C "$work" || die "Couldn't unpack $file: it's damaged, or not a purrlor backup."
  [ -f "$work/env" ] || die "$file isn't a purrlor backup: there are no settings in it."
  if [ -f "$work/MANIFEST" ]; then
    format="$(awk '$1 == "purrlor-backup" { print $2 }' "$work/MANIFEST")"
    created="$(awk '$1 == "created" { print $2 }' "$work/MANIFEST")"
  fi
  [ "${format:-x}" -le "$BACKUP_FORMAT" ] 2>/dev/null \
    || die "This backup was made by a newer Purrlor. Update this one first: sudo purrlor update"
  [ "$(grep '^COMPOSE_PROFILES=' "$work/env" | tail -n1 | cut -d= -f2-)" != matrix ] || bundled=yes
  if [ "$bundled" = yes ]; then
    [ -f "$work/matrix-db.tar.gz" ] || die "$file has the bundled homeserver's settings but none of its data, so it can't be restored."
    gzip -t "$work/matrix-db.tar.gz" || die "The homeserver's data in $file is damaged, so nothing was changed."
  fi

  echo "This backup (made ${created:-$(date -r "$file" '+%F %R')}) holds:"
  echo "   settings (.env), except this server's own address, network, storage and alert settings"
  [ "$bundled" = no ] || echo "   the homeserver: accounts, rooms, messages and uploads"
  if [ -d "$work/token-server" ]; then echo "   moderation: hidden and switched-off pages, takedowns, the audit log"
  else echo "   (no moderation records: it's older than backups that have them, so this server's are kept)"; fi
  if [ -d "$work/push-gateway" ]; then echo "   scheduled reminders"
  else echo "   (no scheduled reminders: it's older than backups that have them, so this server's are kept)"; fi
  echo
  confirm "Restoring replaces this server's data with the backup's: messages, accounts, uploads and
moderation since it was made are lost. Purrlor is offline while it runs. How things are now is
backed up first, so you can come back to it."

  backup_make "$BACKUP_DIR" before-restore
  undo="$BACKUP_FILE"
  say "Saved how things were in $undo"

  say "Stopping Purrlor"
  maintenance_on
  compose stop
  say "Putting the settings back"
  restore_env "$work/env"
  if [ -f "$work/matrix-email.env" ]; then (umask 077 && cp "$work/matrix-email.env" "$EMAIL_FILE"); else rm -f "$EMAIL_FILE"; fi
  if [ -f "$work/install-summary" ]; then (umask 077 && cp "$work/install-summary" .install-summary); fi
  if [ -f "$work/terms.html" ]; then mkdir -p custom && cp "$work/terms.html" custom/terms.html; fi
  media="$(env_get MATRIX_MEDIA_DIR)"
  if [ -n "$media" ]; then mkdir -p "$media"; fi
  # Containers made again from the restored settings (and so with their mounts), not started yet.
  compose up --no-start || restore_failed "$undo" "the containers"

  if has_matrix; then
    say "Putting the homeserver's data back (with a lot of media, this takes a while)"
    docker run --rm --volumes-from "$(service_cid matrix)" -v "$work:/restore:ro" \
      -e "MOVED=$([ -n "$media" ] && echo 1 || echo 0)" alpine sh -c "$MATRIX_IN" \
      || restore_failed "$undo" "the homeserver's data"
  fi
  for svc in token-server push-gateway; do
    [ -d "$work/$svc" ] || continue
    say "Putting the $svc's data back"
    docker run --rm --volumes-from "$(service_cid "$svc")" -v "$work/$svc:/restore:ro" alpine sh -c "$DATA_IN" \
      || restore_failed "$undo" "the $svc's data"
  done

  say "Starting Purrlor"
  compose up -d
  echo
  cmd_status 60
  echo
  say "Restored from $file."
  echo "   If something's wrong, go back to how things were: sudo purrlor restore $undo"
}

# ---------------------------------------------------------------------------
# Alerts: something down, a disk filling up, a backup that didn't happen
# ---------------------------------------------------------------------------

# json_str TEXT -> TEXT as the inside of a JSON string.
json_str() { printf '%s' "$1" | tr -d '\000-\011\013-\037' | sed 's/\\/\\\\/g; s/"/\\"/g' | awk 'NR > 1 { printf "\\n" } { printf "%s", $0 }'; }

# alert_send TEXT -> posts TEXT to PURRLOR_ALERT_URL: in Discord's webhook shape for Discord and
# for Purrlor's own incoming webhooks (docs/webhooks.md), Slack's for Slack, and as plain text for
# anything else (ntfy, most push and chat services).
alert_send() {
  local url proxy noproxy args=(-fsS -m 20 -o /dev/null)
  url="$(env_get PURRLOR_ALERT_URL)"
  [ -n "$url" ] || return 0
  proxy="$(env_get OUTBOUND_PROXY)"; noproxy="$(env_get OUTBOUND_NO_PROXY)"
  [ -z "$proxy" ] || args+=(--proxy "$proxy")
  [ -z "$noproxy" ] || args+=(--noproxy "$noproxy")
  case "$url" in
    https://hooks.slack.com/*) args+=(-H 'Content-Type: application/json' --data-binary "{\"text\":\"$(json_str "$1")\"}") ;;
    */api/webhooks/*) args+=(-H 'Content-Type: application/json' --data-binary "{\"content\":\"$(json_str "$1")\",\"username\":\"purrlor\"}") ;;
    *) args+=(-H 'Content-Type: text/plain; charset=utf-8' --data-binary "$1") ;;
  esac
  curl "${args[@]}" "$url"
}

# alert_problems -> one line for each thing wrong right now; nothing when all is well. A service
# gets three tries 10s apart, so one restarting (an update) isn't reported as down.
alert_problems() {
  local a d use mount seen=" " newest ref app cert svc counts
  a="$(env_get BIND_ADDR)"; a="${a:-127.0.0.1}"
  answers_soon() {
    local i
    for i in 1 2 3; do
      curl -fsS -m 5 --noproxy '*' "$1" >/dev/null 2>&1 && return 0
      [ "$i" -eq 3 ] || sleep 10
    done
    return 1
  }
  if ! in_maintenance; then
    answers_soon "http://$a:8080/" || echo "the web app isn't answering"
    answers_soon "http://$a:3001/health" || echo "the token server isn't answering (voice and the public web are down)"
    answers_soon "http://$a:3002/health" || echo "the push gateway isn't answering (no notifications)"
    answers_soon "http://$a:7880/" || echo "LiveKit isn't answering (voice and video are down)"
    if has_matrix; then answers_soon "http://$a:8008/_matrix/client/versions" || echo "the homeserver isn't answering (chat is down)"; fi
  fi

  # Errors (purrlor errors) over the last 15 minutes: a crash, a service logging them steadily, and
  # the app failing in browsers. Browsers' only past a level, since some come from extensions and
  # tabs left open on an old version, not from anything wrong here.
  if ! in_maintenance && [ -n "$(env_get PURRLOR_METRICS_TOKEN)" ]; then
    for svc in "3001 token server" "3002 push gateway"; do
      counts="$(ops_call "${svc%% *}" '/errors/recent?minutes=15' 2>/dev/null)" || continue
      [ "$(count_of fatal "$counts")" -eq 0 ] || echo "the ${svc#* } crashed and restarted (sudo purrlor errors)"
      [ "$(count_of server "$counts")" -lt 5 ] || echo "the ${svc#* } is logging errors (sudo purrlor errors)"
      [ "${svc%% *}" != 3001 ] || [ "$(count_of web "$counts")" -lt 30 ] || echo "the web app is failing in people's browsers (sudo purrlor errors web)"
    done
  fi

  # The disks Docker, the media folder and the backups are on — each disk once.
  for d in "$(docker info -f '{{.DockerRootDir}}' 2>/dev/null || true)" "$(env_get MATRIX_MEDIA_DIR)" "$BACKUP_DIR"; do
    [ -n "$d" ] && [ -e "$d" ] || continue
    mount="$(df -P "$d" | awk 'NR == 2 { print $6 }')"
    case "$seen" in *" $mount "*) continue ;; esac
    seen="$seen$mount "
    use="$(df -P "$d" | awk 'NR == 2 { sub("%", "", $5); print $5 }')"
    [ "${use:-0}" -lt 90 ] || echo "the disk with $d on it is ${use}% full"
  done

  if cron_has purrlor-backup; then
    [ ! -f "$STATE_DIR/backup-failed" ] || cat "$STATE_DIR/backup-failed"
    [ ! -f "$STATE_DIR/backup-copy-failed" ] || cat "$STATE_DIR/backup-copy-failed"
    # Missed altogether (cron not running, say): measured from the newest nightly backup, or from
    # when they were turned on if there isn't one yet.
    newest="$(ls -1t "$BACKUP_DIR"/purrlor-auto-*.tar.gz 2>/dev/null | head -n1 || true)"
    ref="${newest:-$(cron_file purrlor-backup)}"
    [ -z "$(find "$ref" -mmin +2160 2>/dev/null)" ] || echo "no nightly backup for over a day and a half (is cron running?)"
  fi

  # The certificate, where nginx runs on this server (an edge server renews its own).
  if [ "$(env_get PURRLOR_EDGE)" != true ]; then
    app="$(host_of "$(env_get ALLOWED_ORIGINS | cut -d, -f1)")"
    if [ -n "$app" ]; then
      cert="$(echo | openssl s_client -connect 127.0.0.1:443 -servername "$app" 2>/dev/null | openssl x509 2>/dev/null || true)"
      if [ -n "$cert" ] && ! printf '%s\n' "$cert" | openssl x509 -noout -checkend 1209600 >/dev/null 2>&1; then
        echo "the HTTPS certificate for $app runs out within 14 days (check: certbot renew --dry-run)"
      fi
    fi
  fi
}

# alert_check: the regular run. Says something only when the list of problems changes — what's
# newly wrong, and what's fine again — so a problem is reported once, not every five minutes.
# When the message can't be sent, nothing is remembered, so the next run tries again.
alert_check() {
  local now before newly fixed site msg=""
  mkdir -p "$STATE_DIR"
  now="$(alert_problems | sort -u)"
  before="$(cat "$STATE_DIR/alert-state" 2>/dev/null || true)"
  [ "$now" != "$before" ] || return 0
  newly="$(printf '%s\n' "$now" | grep -vxF -f <(printf '%s\n' "$before") | sed '/^$/d' || true)"
  fixed="$(printf '%s\n' "$before" | grep -vxF -f <(printf '%s\n' "$now") | sed '/^$/d' || true)"
  site="$(host_of "$(env_get ALLOWED_ORIGINS | cut -d, -f1)")"; site="${site:-$(hostname)}"
  [ -z "$newly" ] || msg="Purrlor ($site) needs a look:
$(printf '%s\n' "$newly" | sed 's/^/- /')"
  [ -z "$fixed" ] || msg="${msg:+$msg

}Fine again on Purrlor ($site):
$(printf '%s\n' "$fixed" | sed 's/^/- /')"
  echo "--- $(date '+%F %T') alert"
  printf '%s\n' "$msg"
  if alert_send "$msg"; then printf '%s\n' "$now" > "$STATE_DIR/alert-state"; fi
}

cmd_alerts() {
  local usage="Usage: purrlor alerts [<webhook or ntfy URL> | test | off]"
  need_root alerts
  local url; url="$(env_get PURRLOR_ALERT_URL)"
  case "${1:-}" in
    "")
      [ "$#" -eq 0 ] || die "$usage"
      if [ -n "$url" ] && cron_has purrlor-alerts; then
        say "Alerts are on: checked every few minutes, sent to $url"
        local now; now="$(cat "$STATE_DIR/alert-state" 2>/dev/null || true)"
        if [ -n "$now" ]; then echo "   Wrong at the last check:"; printf '%s\n' "$now" | sed 's/^/     - /'
        else echo "   Nothing was wrong at the last check."; fi
      else
        say "Alerts are off. Turn them on with somewhere to send them, e.g.:"
        echo "   sudo purrlor alerts https://ntfy.sh/<a long random topic name>     (the ntfy app on your phone)"
        echo "   sudo purrlor alerts https://discord.com/api/webhooks/...           (a Discord or Purrlor channel webhook)"
      fi
      ;;
    off)
      [ "$#" -eq 1 ] || die "$usage"
      cron_drop purrlor-alerts
      env_set PURRLOR_ALERT_URL ""
      rm -f "$STATE_DIR/alert-state"
      say "Alerts are off."
      ;;
    test)
      [ "$#" -eq 1 ] || die "$usage"
      [ -n "$url" ] || die "Alerts are off — turn them on first. $usage"
      alert_send "A test from purrlor on $(hostname): alerts reach you." || die "Couldn't send it (the error is above)."
      say "Sent a test to $url"
      ;;
    check) alert_check ;;
    http://*|https://*)
      [ "$#" -eq 1 ] || die "$usage"
      printf '%s' "$1" | grep -Eq '^https?://[^[:space:][:cntrl:]]+$' || die "$usage"
      env_set PURRLOR_ALERT_URL "$1"
      if ! alert_send "Purrlor on $(hostname) will send alerts here: a service down, a disk filling up, a nightly backup that failed."; then
        env_set PURRLOR_ALERT_URL "$url"
        die "Couldn't send to $1 (the error is above), so nothing was changed."
      fi
      mkdir -p "$STATE_DIR"
      rm -f "$STATE_DIR/alert-state"
      cron_put purrlor-alerts often "$REPO_ROOT/deploy/purrlor alerts check"
      say "Alerts are on: sent a first message to $1."
      echo "   Checked every few minutes: each service answering, disks under 90% full, the HTTPS"
      echo "   certificate, and nightly backups (sudo purrlor backup schedule daily). You hear when"
      echo "   something goes wrong and when it's fine again."
      ;;
    *) die "$usage" ;;
  esac
}

# ---------------------------------------------------------------------------
# Errors and metrics (docs/deployment.md, "Errors and metrics")
# ---------------------------------------------------------------------------

OPS_SERVICES="3001 token server
3002 push gateway"

# ops_call PORT PATH [curl args...] -> a service's operator route (ops.ts), with the metrics token.
# The token goes to curl on its standard input, not its command line, where `ps` would show it.
# Prints the answer; says what to do and fails when it isn't 200 or 204.
ops_call() {
  local port="$1" path="$2" a out code
  shift 2
  a="$(env_get BIND_ADDR)"; a="${a:-127.0.0.1}"
  out="$(printf 'header = "Authorization: Bearer %s"\n' "$(env_get PURRLOR_METRICS_TOKEN)" |
    curl -sS -m 10 --noproxy '*' -K - -w '\n%{http_code}' "$@" "http://$a:$port$path" 2>&1)" \
    || { warn "It isn't answering: ${out%%$'\n'*}"; return 1; }
  code="${out##*$'\n'}"; out="${out%$'\n'*}"
  case "$code" in
    200|204) printf '%s' "$out" ;;
    404) warn "It's older than errors and metrics. Update it: sudo purrlor update"; return 1 ;;
    401) warn "It doesn't have this install's metrics token. Restart it so it reads .env again: sudo purrlor restart"; return 1 ;;
    *) warn "It answered $code: $out"; return 1 ;;
  esac
}

# count_of NAME TEXT -> the number after NAME in /errors/recent's answer ("server 3"), 0 if none.
count_of() { printf '%s\n' "$2" | awk -v k="$1" '$1 == k && $2 ~ /^[0-9]+$/ { n = $2 } END { print n + 0 }'; }

# ensure_metrics_token: an install from before errors and metrics has no token; make one, and
# recreate the two services that check it so they know it.
ensure_metrics_token() {
  [ -z "$(env_get PURRLOR_METRICS_TOKEN)" ] || return 0
  env_set PURRLOR_METRICS_TOKEN "$(openssl rand -hex 32)"
  say "Made a metrics token (PURRLOR_METRICS_TOKEN in .env); restarting the token server and push gateway to use it"
  compose up -d token-server push-gateway
  sleep 3
}

cmd_errors() {
  local usage="Usage: purrlor errors [web | server | clear]" query="" port name failed=0
  need_root errors
  [ "$#" -le 1 ] || die "$usage"
  ensure_metrics_token
  case "${1:-}" in
    "") ;;
    server) query="?source=server" ;;
    web)
      # Only the token server takes browsers' reports.
      ops_call 3001 '/errors?source=web' || exit 1
      return 0
      ;;
    clear)
      while read -r port name; do
        if ops_call "$port" /errors/clear -X POST; then say "Cleared the $name's errors"; else failed=1; fi
      done <<< "$OPS_SERVICES"
      return "$failed"
      ;;
    *) die "$usage" ;;
  esac
  while read -r port name; do
    [ "$port" = 3001 ] || echo
    ops_call "$port" "/errors$query" || failed=1
  done <<< "$OPS_SERVICES"
  echo
  echo "Browsers' errors come from the token server (sudo purrlor errors web). 'purrlor errors clear' forgets them all."
  return "$failed"
}

cmd_metrics() {
  local usage="Usage: purrlor metrics [prometheus | new-token]" port name failed=0 a
  need_root metrics
  [ "$#" -le 1 ] || die "$usage"
  ensure_metrics_token
  case "${1:-}" in
    "")
      while read -r port name; do
        [ "$port" = 3001 ] || echo
        ops_call "$port" /stats || failed=1
      done <<< "$OPS_SERVICES"
      echo
      echo "Counted since each service last started. For history, have Prometheus collect them: sudo purrlor metrics prometheus"
      return "$failed"
      ;;
    prometheus)
      a="$(env_get BIND_ADDR)"; a="${a:-127.0.0.1}"
      say "The token server and push gateway serve their numbers at /metrics, for the metrics token:"
      cat <<PROM

  scrape_configs:
    - job_name: purrlor
      authorization:
        credentials_file: /etc/prometheus/purrlor-token   # holding the token below
      static_configs:
        - targets: ['$a:3001', '$a:3002']

PROM
      echo "   The token: $(env_get PURRLOR_METRICS_TOKEN)"
      echo "   Prometheus has to reach $a; on another server, over a private network (BIND_ADDR in .env)."
      echo "   A new token: sudo purrlor metrics new-token (the old one stops working)."
      ;;
    new-token)
      env_set PURRLOR_METRICS_TOKEN "$(openssl rand -hex 32)"
      compose up -d token-server push-gateway
      say "Made a new metrics token; the old one no longer works. Anything scraping /metrics needs the new one: sudo purrlor metrics prometheus"
      ;;
    *) die "$usage" ;;
  esac
}

matrix_only() { has_matrix || die "This install uses its own homeserver's sign-up settings, not Purrlor's bundled one."; }

# new_code -> prints a fresh sign-up code, already saved to .env (and the install summary). The
# homeserver only picks it up when its container is next recreated.
new_code() {
  local token; token="$(openssl rand -hex 16)"
  env_set MATRIX_REGISTRATION_TOKEN "$token"
  sed -i "s/^    [0-9a-f]\{32,64\}$/    $token/" .install-summary 2>/dev/null || true
  printf '%s' "$token"
}

cmd_new_invite_code() {
  need_root new-invite-code; matrix_only
  local token; token="$(new_code)"
  compose up -d matrix
  say "New sign-up code (the old one no longer works):"
  echo "    $token"
  if email_only; then
    echo "   Sign-up is by email right now, and this code lets someone skip the email check — only"
    echo "   hand it to people you trust."
  fi
}

cmd_signups() {
  need_root "$1-signups"; matrix_only
  if [ "$1" = open ]; then
    env_set MATRIX_ALLOW_REGISTRATION true
    compose up -d matrix
    if email_only; then
      say "Sign-up is open to anyone who confirms an email address."
    else
      say "Sign-up is open to anyone with the sign-up code: $(env_get MATRIX_REGISTRATION_TOKEN)"
    fi
  else
    env_set MATRIX_ALLOW_REGISTRATION false
    compose up -d matrix
    say "Sign-up is closed. Create accounts from the admin room: !admin users create-user <name>"
  fi
}
# ---------------------------------------------------------------------------
# Email verification (bundled homeserver)
# ---------------------------------------------------------------------------

# The homeserver's mail settings live in a file of their own, not in .env: Continuwuity refuses to
# start on a blank mail setting, so they can't be compose variables that are simply empty while
# email is off. deploy/docker-compose.yml loads this file when it exists.
EMAIL_FILE="$REPO_ROOT/matrix-email.env"

email_setting() { sed -n "s/^$1='\(.*\)'$/\1/p" "$EMAIL_FILE" 2>/dev/null | tail -n1; }

# Sign-up by verified email alone, no code needed (rather than a code plus a verified email).
email_only() { [ "$(email_setting CONTINUWUITY_SMTP__REQUIRE_EMAIL_FOR_REGISTRATION)" = true ]; }

# urlencode STRING -> STRING made safe to put in a URL (a password with @ or : in it, say).
urlencode() {
  local LC_ALL=C s="$1" out="" c i
  for ((i = 0; i < ${#s}; i++)); do
    c="${s:i:1}"
    case "$c" in
      [A-Za-z0-9._~-]) out+="$c" ;;
      *) out+="$(printf '%%%02X' "'$c")" ;;
    esac
  done
  printf '%s' "$out"
}

# email_hint ERROR -> a plain-language next step for the homeserver's SMTP error, if there is one.
email_hint() {
  case "$1" in
    *"invalid domain character"*)
      echo "Use the mail server's name, not its IP address: the connection is encrypted, and its certificate is for the name." ;;
    *"lookup address"*|*"Name or service not known"*|*"Name does not resolve"*)
      echo "The homeserver couldn't look that name up. It asks this server's own DNS servers first (from /etc/resolv.conf), then 1.1.1.1 — check the spelling, and that one of those knows the name." ;;
    *"STARTTLS is not supported"*)
      echo "That port doesn't offer STARTTLS. Most providers use 587 for it; for port 465 choose the TLS option." ;;
    *"authentication"*|*"Authentication"*|*"535"*|*"credentials"*)
      echo "The mail server turned down the username or password. Many providers (Gmail, Outlook, iCloud) need an app password here, not your normal one." ;;
    *"timed out"*|*"Timeout"*|*"Connection refused"*|*"os error 111"*|*"os error 110"*)
      echo "Couldn't connect to it. Many hosting providers block outgoing mail ports (25, 465, 587) until you ask them to lift it; also check the port number." ;;
    *"certificate"*|*"InvalidCertificate"*|*"handshake"*)
      echo "The TLS handshake failed — usually the wrong security option for that port (465 is TLS, 587 is STARTTLS)." ;;
  esac
}

# email_wait SINCE -> "ok", or the homeserver's own words for why its mail check failed. It tests
# the connection each time it starts and logs the result either way.
email_wait() {
  local logs line
  for _ in $(seq 1 45); do
    logs="$(compose logs --no-color --since "$1" matrix 2>&1 | sed 's/\x1b\[[0-9;]*m//g' || true)"
    if printf '%s' "$logs" | grep -q 'SMTP connection test successful'; then echo ok; return; fi
    line="$(printf '%s' "$logs" | grep -oE '(SMTP connection test failed|Failed to set up SMTP transport): .*' | head -n1 || true)"
    if [ -n "$line" ]; then echo "$line"; return; fi
    sleep 2
  done
  echo "no word from the homeserver about its mail server within 90 seconds ('purrlor logs matrix' shows what it's doing)"
}

# email_apply URI SENDER [MODE] -> requires new accounts to verify an email address, sending
# through that mail server — but only once the homeserver has proven it can log in to it. A mail
# setting it can't use stops it from starting at all, so on failure the previous settings go
# straight back. MODE "code" (the default) keeps the sign-up code too; "open" drops it, so anyone
# who confirms an email address can sign up.
email_apply() {
  local uri="$1" sender="$2" mode="${3:-code}" base since result backup="" old_code="" require
  base="$(env_get PURRLOR_HOMESERVER_URL)"
  [ -n "$base" ] || die "PURRLOR_HOMESERVER_URL isn't in .env — re-run setup.sh."
  case "$uri$sender" in *"'"*) die "The mail settings can't contain a ' character." ;; esac
  case "$mode" in
    open) require=REQUIRE_EMAIL_FOR_REGISTRATION ;;
    code) require=REQUIRE_EMAIL_FOR_TOKEN_REGISTRATION ;;
    *) die "Unknown sign-up mode: $mode" ;;
  esac
  # Continuwuity keeps the configured code working alongside email-only sign-up, as a way to skip
  # the email check (verified live: it offers the two as alternatives). Codes already handed out
  # shouldn't keep that power, so switching to email-only replaces the code with one nobody has.
  if [ "$mode" = open ] && ! email_only; then old_code="$(env_get MATRIX_REGISTRATION_TOKEN)"; new_code >/dev/null; fi
  if [ -f "$EMAIL_FILE" ]; then backup="$(mktemp)"; cp "$EMAIL_FILE" "$backup"; fi
  (
    umask 077
    cat > "$EMAIL_FILE" <<EMAIL_EOF
# Email verification for new accounts on the bundled homeserver. Managed by 'purrlor email' —
# 'purrlor email setup' to change it, 'purrlor email codes on|off' to switch whether a sign-up
# code is needed too, 'purrlor email off' to turn it off. Not in git: it holds the mail server's
# password.
CONTINUWUITY_SMTP__CONNECTION_URI='$uri'
CONTINUWUITY_SMTP__SENDER='$sender'
# REQUIRE_EMAIL_FOR_TOKEN_REGISTRATION: a sign-up code AND a verified email address.
# REQUIRE_EMAIL_FOR_REGISTRATION: a verified email address alone is enough.
CONTINUWUITY_SMTP__$require='true'
# The verification link in the email points here, so it has to be the homeserver's public address.
CONTINUWUITY_WELL_KNOWN__CLIENT='$base'
EMAIL_EOF
  )
  say "Restarting the homeserver with the new mail settings, and waiting for it to test them"
  since="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  compose up -d --force-recreate matrix
  result="$(email_wait "$since")"
  if [ "$result" = ok ]; then
    rm -f "$backup"
    say "Email verification is on: new accounts confirm an address from a link sent by $sender"
    if [ "$mode" = open ]; then
      echo "   No sign-up code needed: anyone who confirms an email address can create an account."
      [ "$(env_get MATRIX_ALLOW_REGISTRATION)" != false ] || echo "   (Sign-up itself is closed right now — open it with: sudo purrlor open-signups)"
    else
      echo "   They also need the sign-up code: $(env_get MATRIX_REGISTRATION_TOKEN)"
    fi
    return 0
  fi
  if [ -n "$backup" ]; then mv "$backup" "$EMAIL_FILE"; else rm -f "$EMAIL_FILE"; fi
  if [ -n "$old_code" ]; then env_set MATRIX_REGISTRATION_TOKEN "$old_code"; sed -i "s/^    [0-9a-f]\{32,64\}$/    $old_code/" .install-summary 2>/dev/null || true; fi
  compose up -d --force-recreate matrix
  warn "The homeserver couldn't use that mail server, so nothing was changed:"
  warn "  $result"
  local hint; hint="$(email_hint "$result")"
  [ -z "$hint" ] || echo "   $hint" >&2
  return 1
}

# urldecode STRING -> STRING with its %XX escapes turned back into characters (urlencode's opposite).
urldecode() { printf '%b' "${1//%/\\x}"; }

# email_current -> CUR_HOST CUR_PORT CUR_USER CUR_PASS CUR_ADDR CUR_NAME, read back from the saved
# mail settings (all empty when email verification is off), so changing one thing doesn't mean
# typing the rest again.
email_current() {
  CUR_HOST=""; CUR_PORT=""; CUR_USER=""; CUR_PASS=""; CUR_ADDR=""; CUR_NAME=""
  [ -f "$EMAIL_FILE" ] || return 0
  local uri rest auth sender
  uri="$(email_setting CONTINUWUITY_SMTP__CONNECTION_URI)"
  rest="${uri#*://}"
  rest="${rest%%\?*}"
  if [[ "$rest" == *@* ]]; then
    # urlencode turned any @ or : in the username and password into %40 and %3A, so these split cleanly.
    auth="${rest%@*}"
    rest="${rest##*@}"
    CUR_USER="$(urldecode "${auth%%:*}")"
    if [[ "$auth" == *:* ]]; then CUR_PASS="$(urldecode "${auth#*:}")"; fi
  fi
  CUR_HOST="${rest%:*}"
  CUR_PORT="${rest##*:}"
  sender="$(email_setting CONTINUWUITY_SMTP__SENDER)"
  if [[ "$sender" =~ ^(.*)\ \<([^\>]+)\>$ ]]; then
    CUR_NAME="${BASH_REMATCH[1]}"
    CUR_ADDR="${BASH_REMATCH[2]}"
  else
    CUR_ADDR="$sender"
  fi
}

email_prompt() {
  local host port security user pass sender_addr sender_name example
  email_current
  if [ -n "$CUR_HOST" ]; then
    echo "Changing the mail server the homeserver sends from. Press Enter to keep what's in [brackets];"
    echo "the password is kept too unless you type a new one. The new settings are tested before"
    echo "they replace the old ones, so if they don't work nothing changes."
  else
    echo "New accounts will have to confirm an email address by clicking a link. The homeserver"
    echo "sends that email through a mail server you have an account on — your email provider's"
    echo "SMTP settings, or a sending service (Resend, Postmark, Mailgun, Amazon SES, Brevo...)."
  fi
  echo
  local hint=", e.g. smtp.example.com"
  [ -z "$CUR_HOST" ] || hint=" [$CUR_HOST]"
  read -r -p "Mail server (SMTP) host$hint: " host
  host="${host:-$CUR_HOST}"
  [ -n "$host" ] || die "No mail server given — nothing changed."
  read -r -p "Port [${CUR_PORT:-587}]: " port; port="${port:-${CUR_PORT:-587}}"
  case "$port" in *[!0-9]*|'') die "The port has to be a number." ;; esac
  if [ "$port" = 465 ]; then security=tls; else security=starttls; fi
  hint="; blank if none"
  [ -z "$CUR_USER" ] || hint="; Enter keeps $CUR_USER, - for none"
  read -r -p "Username (often your full email address$hint): " user
  if [ "$user" = - ]; then user=""; else user="${user:-$CUR_USER}"; fi
  if [ -n "$user" ]; then
    if [ "$user" = "$CUR_USER" ] && [ -n "$CUR_PASS" ]; then
      read -r -s -p "Password (Enter keeps the current one): " pass; echo
      pass="${pass:-$CUR_PASS}"
    else
      read -r -s -p "Password (an app password for Gmail/Outlook/iCloud): " pass; echo
    fi
  fi
  example="noreply@$(host_of "$(env_get PURRLOR_HOMESERVER_URL)" | sed 's/^matrix\.//')"
  read -r -p "Send from this address [${CUR_ADDR:-e.g. $example}]: " sender_addr
  sender_addr="${sender_addr:-$CUR_ADDR}"
  printf '%s' "$sender_addr" | grep -q '@' || die "That doesn't look like an email address — nothing changed."
  read -r -p "Name it's from [${CUR_NAME:-Purrlor}]: " sender_name; sender_name="${sender_name:-${CUR_NAME:-Purrlor}}"

  # smtps:// is TLS from the first byte (port 465); smtp://…?tls=required upgrades with STARTTLS
  # (587, 25) and refuses to go on unencrypted.
  local auth=""
  [ -z "$user" ] || auth="$(urlencode "$user"):$(urlencode "$pass")@"
  if [ "$security" = tls ]; then
    SMTP_URI="smtps://$auth$host:$port"
  else
    SMTP_URI="smtp://$auth$host:$port?tls=required"
  fi
  SMTP_SENDER="$sender_name <$sender_addr>"

  local current=2 choice
  if email_only; then current=1; fi
  echo
  echo "Who can sign up once email verification is on?"
  echo "  1) Anyone who confirms an email address — no sign-up code needed"
  echo "  2) Only people with the sign-up code, who also confirm an email address"
  read -r -p "Choice [$current]: " choice; choice="${choice:-$current}"
  case "$choice" in
    1) SMTP_MODE=open ;;
    2) SMTP_MODE=code ;;
    *) die "Pick 1 or 2 — nothing changed." ;;
  esac
}

cmd_email() {
  case "${1:-status}" in
    status)
      matrix_only
      if [ -f "$EMAIL_FILE" ]; then
        local uri; uri="$(email_setting CONTINUWUITY_SMTP__CONNECTION_URI | sed -E 's#^([a-z]+://)[^@/]*@#\1***@#')"
        if email_only; then
          say "Anyone who verifies an email address can sign up — no sign-up code needed."
        else
          say "New accounts need the sign-up code and a verified email address."
        fi
        echo "   Sent from $(email_setting CONTINUWUITY_SMTP__SENDER) through $uri"
        local seen
        seen="$(compose logs --no-color matrix 2>&1 | sed 's/\x1b\[[0-9;]*m//g' | grep -oE 'SMTP connection test (successful|failed: .*)' | tail -n1 || true)"
        [ -z "$seen" ] || echo "   Homeserver's last check: $seen"
        if email_only; then
          echo "   Require a sign-up code too: sudo purrlor email codes on"
        else
          echo "   Drop the sign-up code (email alone is enough): sudo purrlor email codes off"
        fi
        echo "   Change the mail server: sudo purrlor email setup    Turn it off: sudo purrlor email off"
      else
        say "Email verification is off — new accounts only need the sign-up code."
        echo "   Turn it on: sudo purrlor email setup"
      fi
      ;;
    setup)
      need_root email setup; matrix_only
      email_prompt
      email_apply "$SMTP_URI" "$SMTP_SENDER" "$SMTP_MODE"
      ;;
    codes)
      need_root email codes; matrix_only
      [ -f "$EMAIL_FILE" ] || die "Email verification is off, so a sign-up code is the only way in. Set it up first: sudo purrlor email setup"
      local mode
      case "${2:-}" in
        on) mode=code ;;
        off) mode=open ;;
        *) die "Usage: purrlor email codes on|off   (on: a sign-up code and a verified email; off: a verified email alone)" ;;
      esac
      email_apply "$(email_setting CONTINUWUITY_SMTP__CONNECTION_URI)" "$(email_setting CONTINUWUITY_SMTP__SENDER)" "$mode"
      ;;
    off)
      need_root email off; matrix_only
      [ -f "$EMAIL_FILE" ] || { say "Email verification is already off."; return 0; }
      rm -f "$EMAIL_FILE"
      compose up -d --force-recreate matrix
      say "Email verification is off — new accounts need the sign-up code: $(env_get MATRIX_REGISTRATION_TOKEN)"
      ;;
    *) die "Usage: purrlor email [setup|codes on|codes off|off]" ;;
  esac
}

# setup.sh's way in: the settings it asked for arrive in PURRLOR_SMTP_URI / PURRLOR_SMTP_SENDER
# (environment, so the password isn't on a command line).
cmd_email_apply() {
  need_root email-apply; matrix_only
  email_apply "${PURRLOR_SMTP_URI:?}" "${PURRLOR_SMTP_SENDER:?}" "${PURRLOR_SMTP_MODE:-code}"
}

# ---------------------------------------------------------------------------
# Media storage (bundled homeserver)
# ---------------------------------------------------------------------------

# Continuwuity keeps uploads in <database>/media — inside the matrix-db volume, so on Docker's
# disk. To put them elsewhere, the compose file always mounts MATRIX_MEDIA_DIR (unset: an unused
# empty volume) at /purrlor-media, and moving there turns that media folder into a symlink to it.
# Every step below runs in a throwaway container sharing the homeserver's mounts, the same way
# 'purrlor backup' reads its data.
MEDIA=/var/lib/continuwuity/media

# media_sh [docker run options...] SCRIPT -> runs SCRIPT against the homeserver container's mounts.
media_sh() {
  local script="${*: -1}" cid
  cid="$(compose ps -a -q matrix)"
  [ -n "$cid" ] || die "The homeserver container doesn't exist yet — start it first: purrlor restart matrix"
  docker run --rm --volumes-from "$cid" "${@:1:$#-1}" alpine sh -c "$script"
}

# The copies, run with the homeserver stopped. Each checks the copy against the original — file
# count and total bytes — before switching anything, and prints that count. tally's trailing /.
# follows the media folder when it's a symlink; links inside it stay links, as cp -a leaves them.
#
# Out to a folder (mounted at /to here, at /purrlor-media once the homeserver restarts): the media
# folder then becomes a link to it. A real folder — media in Docker's storage until now — is set
# aside rather than deleted, until the move has worked.
read -r -d '' MEDIA_OUT <<'SH' || true
set -e
tally() { find "$1/." -type f -exec stat -c %s {} + | awk '{ n++; s += $1 } END { print n + 0, s + 0 }'; }
M=/var/lib/continuwuity/media
[ -e "$M" ] || mkdir -p "$M"
chown "$(stat -Lc %u:%g "$M")" /to
cp -a "$M/." /to/
a="$(tally "$M")"; b="$(tally /to)"
[ "$a" = "$b" ] || { echo "The copy doesn't match the original ($a vs $b files/bytes)." >&2; exit 1; }
if [ -L "$M" ]; then rm "$M"; else mv "$M" "$M.moved-away"; fi
ln -s /purrlor-media "$M"
echo "$a"
SH

# Back into Docker's storage: copy beside the link, then swap the copy in for it.
read -r -d '' MEDIA_BACK <<'SH' || true
set -e
tally() { find "$1/." -type f -exec stat -c %s {} + | awk '{ n++; s += $1 } END { print n + 0, s + 0 }'; }
M=/var/lib/continuwuity/media
rm -rf "$M.new"
mkdir "$M.new"
chown "$(stat -Lc %u:%g "$M")" "$M.new"
cp -a "$M/." "$M.new/"
a="$(tally "$M")"; b="$(tally "$M.new")"
[ "$a" = "$b" ] || { rm -rf "$M.new"; echo "The copy doesn't match the original ($a vs $b files/bytes)." >&2; exit 1; }
rm "$M"
mv "$M.new" "$M"
echo "$a"
SH

media_where() {
  local dir; dir="$(env_get MATRIX_MEDIA_DIR)"
  if [ -n "$dir" ]; then echo "$dir"; else echo "Docker's storage (the homeserver's own volume)"; fi
}

# free_kb DIR -> kilobytes free on DIR's filesystem.
free_kb() { df -Pk "$1" | awk 'NR == 2 { print $4 }'; }

cmd_media_status() {
  say "Media is stored in: $(media_where)"
  local used dir
  used="$(media_sh "[ -e $MEDIA ] && du -shL $MEDIA/ | cut -f1 || echo nothing yet")"
  echo "   Taking up: $used"
  dir="$(env_get MATRIX_MEDIA_DIR)"
  [ -n "$dir" ] || dir="$(docker info -f '{{.DockerRootDir}}')"
  echo "   Free there: $(df -Ph "$dir" | awk 'NR == 2 { print $4 }')"
  echo "   Move it: sudo purrlor media move /path/to/dir    Back to Docker's storage: sudo purrlor media move default"
}

cmd_media_move() {
  local target="${1:-}" current dest need free answer tally
  [ -n "$target" ] || die "Usage: purrlor media move /path/to/dir   (or 'default' for Docker's storage)"
  current="$(env_get MATRIX_MEDIA_DIR)"

  if [ "$target" = default ]; then
    dest=""
    [ -n "$current" ] || die "Media is already in Docker's storage."
  else
    case "$target" in /*) ;; *) die "Give the full path, starting with / — e.g. /mnt/storage/purrlor-media" ;; esac
    case "$target" in *[[:space:]:,]*) die "The path can't contain spaces, ':' or ','." ;; esac
    # Tidied by hand rather than with `realpath -m`, which BusyBox (Alpine hosts) doesn't have.
    case "/$target/" in */./*|*/../*) die "Give the path without . or .. in it." ;; esac
    dest="$(printf '%s' "$target" | tr -s /)"
    dest="${dest%/}"
    dest="${dest:-/}"
    # A symlinked folder on the way is followed, as Docker will when it mounts it.
    if [ -d "$dest" ]; then
      dest="$(cd "$dest" && pwd -P)"
    elif [ "$dest" != / ] && [ -d "$(dirname "$dest")" ]; then
      dest="$(cd "$(dirname "$dest")" && pwd -P)/$(basename "$dest")"
      dest="$(printf '%s' "$dest" | tr -s /)"
    fi
    [ "$dest" != / ] || die "Not the root directory — pick a folder for it."
    [ "$dest" != "$current" ] || die "Media is already stored in $dest."
    if [ -e "$dest" ] && [ -n "$(ls -A "$dest" 2>/dev/null)" ]; then
      die "$dest isn't empty — pick an empty or new folder, so nothing already there gets mixed in."
    fi
  fi

  # A copy set aside by an earlier move and never deleted would be in the way of setting this one's aside.
  if [ -n "$dest" ] && [ -z "$current" ] && [ "$(media_sh "[ -e $MEDIA.moved-away ] && echo yes || true")" = yes ]; then
    die "An earlier move's old copy is still in Docker's storage — delete it first: sudo purrlor media clean"
  fi

  need="$(media_sh "[ -e $MEDIA ] && du -skL $MEDIA/ | cut -f1 || echo 0")"
  if [ -n "$dest" ]; then
    mkdir -p "$dest"
    free="$(free_kb "$dest")"
  else
    free="$(free_kb "$(docker info -f '{{.DockerRootDir}}')")"
  fi
  # Room for the copy, with a margin: the homeserver keeps writing to that disk afterwards too.
  if [ "$free" -lt $(( need + need / 20 + 102400 )) ]; then
    [ -z "$dest" ] || rmdir "$dest" 2>/dev/null || true
    die "Not enough space there: media takes $(( need / 1024 )) MB, and only $(( free / 1024 )) MB is free."
  fi

  local to="Docker's storage"; [ -z "$dest" ] || to="$dest"
  echo "Moving $(( need / 1024 )) MB of media from $(media_where) to $to."
  echo "The homeserver is stopped while it copies (chat and calls go offline for that time); the old"
  echo "copy stays until the new one is checked and the homeserver is running on it."
  read -r -p "Go ahead? [y/N] " answer
  case "$answer" in [yY]*) ;; *) [ -z "$dest" ] || rmdir "$dest" 2>/dev/null || true; die "Nothing changed." ;; esac

  say "Stopping the homeserver"
  compose stop matrix

  say "Copying"
  if [ -n "$dest" ]; then
    if ! tally="$(media_sh -v "$dest:/to" "$MEDIA_OUT")"; then
      compose start matrix
      warn "The copy failed, so nothing was switched — the homeserver is back on the media where it was."
      die "The partial copy is in $dest; delete it before trying again."
    fi
  elif ! tally="$(media_sh "$MEDIA_BACK")"; then
    compose start matrix
    die "The copy failed, so nothing was switched — the homeserver is back on the media where it was."
  fi
  echo "   Copied and checked: ${tally% *} files, $(( ${tally#* } / 1048576 )) MB"

  env_set MATRIX_MEDIA_DIR "$dest"
  say "Starting the homeserver on the new location"
  compose up -d matrix
  say "Media is now stored in: $(media_where)"

  # The old copy, now unused.
  echo
  if [ -z "$current" ]; then
    read -r -p "Delete the old copy in Docker's storage to free the space? [y/N] " answer
    case "$answer" in
      [yY]*) media_sh "rm -rf $MEDIA.moved-away"; say "Deleted." ;;
      *) echo "   Kept. Delete it later with: sudo purrlor media clean" ;;
    esac
  else
    read -r -p "Delete the old copy in $current to free the space? [y/N] " answer
    case "$answer" in
      [yY]*) rm -rf "${current:?}"; say "Deleted." ;;
      *) echo "   Kept. Delete it later with: sudo rm -rf $current" ;;
    esac
  fi
}

cmd_media() {
  need_root media; matrix_only
  case "${1:-status}" in
    status) cmd_media_status ;;
    move) cmd_media_move "${2:-}" ;;
    clean)
      media_sh "[ -e $MEDIA.moved-away ] && rm -rf $MEDIA.moved-away && echo removed || echo none" \
        | grep -q removed && say "Deleted the old copy from Docker's storage." || say "There's no old copy to delete."
      ;;
    *) die "Usage: purrlor media [status|move /path/to/dir|move default|clean]" ;;
  esac
}

# ---------------------------------------------------------------------------
# Accounts (bundled homeserver)
# ---------------------------------------------------------------------------

# Continuwuity has no admin HTTP API (Synapse-style admin tools get nothing from it): accounts are
# managed by typing '!admin ...' into its #admins room. So that's what this does — logs in as the
# admin, posts the command there, prints the server's reply, and logs that session out again.
# The command and reply stay in the admin room like any other, so there's a record of them.
#
# It runs in the token-server container: that already has Node (to read the server's JSON
# replies; this host may have no jq) and shares a network with the homeserver. The password goes
# in on stdin, never on a command line.
read -r -d '' ADMIN_JS <<'JS' || true
const [server, user, password, ...rest] = require('fs').readFileSync(0, 'utf8').split('\n');
const command = rest.join('\n').trim();
const base = 'http://matrix:8008/_matrix/client/v3';
let token;
async function call(method, path, body) {
  const res = await fetch(base + path, {
    method,
    headers: { 'Content-Type': 'application/json', ...(token ? { Authorization: 'Bearer ' + token } : {}) },
    body: body ? JSON.stringify(body) : undefined,
  });
  const data = await res.json().catch(() => ({}));
  if (!res.ok) throw new Error(data.error || `HTTP ${res.status}`);
  return data;
}
(async () => {
  try {
    token = (await call('POST', '/login', {
      type: 'm.login.password',
      identifier: { type: 'm.id.user', user },
      password,
      initial_device_display_name: 'purrlor command line',
    })).access_token;
  } catch (err) {
    console.error(`Couldn't log in as ${user}: ${err.message}`);
    process.exit(1);
  }
  try {
    const { room_id: room } = await call('GET', '/directory/room/' + encodeURIComponent(`#admins:${server}`));
    const r = encodeURIComponent(room);
    const { event_id: sent } = await call('PUT', `/rooms/${r}/send/m.room.message/purrlor-${Date.now()}`, {
      msgtype: 'm.text',
      body: `!admin ${command}`,
    });
    // The server answers with a reply to the command's event. Deactivating someone in many rooms
    // can take a while, hence the generous wait.
    for (let i = 0; i < 60; i++) {
      await new Promise((done) => setTimeout(done, 1000));
      const { chunk } = await call('GET', `/rooms/${r}/messages?dir=b&limit=50`);
      const reply = chunk.find((e) => e.content?.['m.relates_to']?.['m.in_reply_to']?.event_id === sent);
      if (reply) {
        console.log(reply.content.body);
        return;
      }
    }
    console.error('No answer from the homeserver within a minute. Is that the admin account? Commands from anyone else are ignored.');
    process.exitCode = 1;
  } catch (err) {
    console.error(`The admin room turned that down: ${err.message}`);
    process.exitCode = 1;
  } finally {
    await call('POST', '/logout', {}).catch(() => {});
  }
})();
JS

# ask_admin_credentials -> sets PURRLOR_ADMIN_USER and PURRLOR_ADMIN_PASSWORD, asking for whichever
# isn't already in the environment (setup.sh passes both, so the installer never asks twice).
ask_admin_credentials() {
  local default
  default="$(grep -o 'Log in as @[^ ]*' .install-summary 2>/dev/null | head -n1 | cut -c11- || true)"
  if [ -z "${PURRLOR_ADMIN_USER:-}" ]; then
    read -r -p "Admin account${default:+ [$default]}: " PURRLOR_ADMIN_USER
    PURRLOR_ADMIN_USER="${PURRLOR_ADMIN_USER:-$default}"
    [ -n "$PURRLOR_ADMIN_USER" ] || die "No admin account given."
  fi
  if [ -z "${PURRLOR_ADMIN_PASSWORD:-}" ]; then
    read -r -s -p "Password for $PURRLOR_ADMIN_USER: " PURRLOR_ADMIN_PASSWORD; echo
  fi
}

# admin_run COMMAND -> runs '!admin COMMAND' on the bundled homeserver as its admin and prints the
# reply. Asks which account is the admin (offering the one setup.sh created) and its password.
admin_run() {
  local server
  server="$(env_get MATRIX_SERVER_NAME)"
  [ -n "$server" ] || die "MATRIX_SERVER_NAME isn't in .env — re-run setup.sh."
  ask_admin_credentials
  say "Running in the admin room: !admin $1"
  # NODE_USE_ENV_PROXY emptied: the homeserver is on the local Docker network, never via the proxy.
  printf '%s\n%s\n%s\n%s\n' "$server" "$PURRLOR_ADMIN_USER" "$PURRLOR_ADMIN_PASSWORD" "$1" \
    | compose exec -T -e NODE_USE_ENV_PROXY= token-server node -e "$ADMIN_JS" \
    || die "That didn't go through (above says why). If the token server isn't running, 'purrlor status' shows it."
}

# full_user_id NAME -> @name:server, from "name", "@name" or "@name:server".
full_user_id() {
  local name="${1#@}"
  case "$name" in *:*) printf '@%s' "$name" ;; *) printf '@%s:%s' "$name" "$(env_get MATRIX_SERVER_NAME)" ;; esac
}

cmd_user() {
  local usage="Usage: purrlor user list | reset-password <name> | deactivate <name> | email <name> [address] | find-email <address>"
  local sub="${1:-}"
  need_root user; matrix_only
  case "$sub" in
    list)
      admin_run "users list"
      ;;
    reset-password)
      [ -n "${2:-}" ] || die "$usage"
      # Signs them out everywhere too — a stuck or taken-over account shouldn't keep old sessions.
      admin_run "users reset-password --logout $(full_user_id "$2")"
      echo "   Give them that password; they can change it in their settings once they're in."
      ;;
    deactivate)
      [ -n "${2:-}" ] || die "$usage"
      local id confirm; id="$(full_user_id "$2")"
      echo "Deactivating $id can't be undone, and the name can never be signed up for again (Matrix"
      echo "doesn't reuse user IDs). To hand a stuck account back to its owner instead:"
      echo "  purrlor user reset-password $2"
      read -r -p "Type the name to deactivate it: " confirm
      [ "$(full_user_id "$confirm")" = "$id" ] || die "Didn't match — nothing changed."
      admin_run "users deactivate $id"
      ;;
    email)
      [ -n "${2:-}" ] || die "$usage"
      # No address removes theirs — which frees it for someone signing up again.
      admin_run "users change-email $(full_user_id "$2")${3:+ $3}"
      ;;
    find-email)
      [ -n "${2:-}" ] || die "$usage"
      admin_run "users get-user-by-email $2"
      ;;
    *) die "$usage" ;;
  esac
}

cmd_admin() {
  need_root admin; matrix_only
  [ -n "${1:-}" ] || die "Usage: purrlor admin <command>   e.g. purrlor admin users list-joined-rooms @name:server"
  admin_run "$*"
}

